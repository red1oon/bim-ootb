{
  // Editor-only (never loaded by a page). Spec: bim-compiler prompts/EDITOR_MAINTAINABILITY_STUDY.md §8 S2.
  // Search hides vendored libraries and generated one-line data files, so results show project code.
  // To search them anyway, click the "Use Exclude Settings" toggle in the Search panel.
  "search.exclude": {
    "viewer/lib/**": true,
    "erp/lib/**": true,
    "modeller/lib/**": true,
    "common/lib/**": true,
    "erp/sqljs/**": true,
    "**/*.min.js": true,
    "out/**": true,
    "logs/**": true,
    "erp/genesis_dict.js": true,
    "erp/fk_rules.js": true,
    "erp/team_plan.js": true,
    "erp/team_plan_pos.js": true,
    "erp/genesis_seed.js": true,
    "erp/ad_official_indexes.js": true,
    "erp/SW_VERSION_HISTORY.md": true
  },
  // Editing style = the code as it is (§14 N3, measured): 2-space default, but each file's own indent is detected and kept
  // (115 JS files use 4). LF, final newline. Trailing spaces are not trimmed (that would add noise to diffs).
  "editor.detectIndentation": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": false,
  "[python]": { "editor.tabSize": 4 },
  // Generated / extracted data: edit the generator named on line 1 of each file, never the file itself.
  "files.readonlyInclude": {
    "erp/genesis_dict.js": true,
    "erp/fk_rules.js": true,
    "erp/team_plan.js": true,
    "erp/team_plan_pos.js": true,
    "erp/genesis_seed.js": true,
    "erp/ad_official_indexes.js": true,
    "internal/APP_SURFACE.md": true
  }
}
