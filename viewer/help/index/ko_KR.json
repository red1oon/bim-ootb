{"v":1,"app":"viewer","lang":"ko_KR","spec":"bim-compiler prompts/HELP_QUERY_CORE_DESIGN.md","built":{"tool":"build_help_index.js","node":"18.19.1","icu":"74.2"},"bm25":{"k1":1.2,"b":0.75,"scale":1000000000},"weights":{"n":3,"a":3,"d":2,"h":1,"pair":1},"kinds":["pill","howto"],"ntexts":0,"nospace":"\\u3040-\\u30ff\\u3400-\\u4dbf\\u4e00-\\u9fff\\uf900-\\ufaff\\u0e00-\\u0e7f","vocab":[],"records":[{"id":"pill/audio","k":"pill","n":"효과음","a":["V"],"d":"타임머신: 시공 단계별 신호음\n비행 투어: 위치 기반 웨이포인트 신호\nUI: 부드러운 탭 소리\n합성음 — 오디오 파일 없음, 기본값 꺼짐","go":{"hkey":"audio"}},{"id":"pill/background","k":"pill","n":"배경","a":["B"],"go":{"hkey":"background"}},{"id":"pill/bbox","k":"pill","n":"경계 상자","go":{"hkey":"bbox"}},{"id":"pill/cam-pivot","k":"pill","n":"자동 피벗","a":["Q"],"go":{"hkey":"cam-pivot"}},{"id":"pill/cam-reset","k":"pill","n":"카메라 초기화","a":["A"],"go":{"hkey":"cam-reset"}},{"id":"pill/camview","k":"pill","n":"카메라 / 보기","go":{"hkey":"camview"}},{"id":"pill/clash","k":"pill","n":"간섭 매트릭스","a":["C"],"d":"공종 쌍 격자\n허용오차 1–100mm\n상태: 검토/해결/수용\nHTML 보고서 + CSV 내보내기","go":{"hkey":"clash"}},{"id":"pill/dlodnav","k":"pill","n":"탐색 LOD (대형 건물)","a":["O"],"d":"비행/궤도 이동 중 멀리 있거나 화면 밖인 요소를 상자로 표시\n50 m 이내 + 시야 안은 실제 메시\n타임머신, 찾기 격리, 시네마 중에는 꺼짐","go":{"hkey":"dlodnav"}},{"id":"pill/docHist","k":"pill","n":"페이지 기록","a":["Z"],"d":"이 페이지 자체의 점 타임라인\n편집 내역을 뒤로/앞으로","go":{"hkey":"docHist"}},{"id":"pill/egress","k":"pill","n":"피난","a":["E"],"d":"고립된 방 (측정된 탈출 경로 없음)\n피난 거리 (실제 출구까지, 없으면 주동선으로 대체)\n문 폭 (참고)","go":{"hkey":"egress"}},{"id":"pill/ew","k":"pill","n":"토공","a":["U"],"d":"절토 및 성토 오버레이 (추정)\n비용 · 기간 · 장비: 보류","go":{"hkey":"ew"}},{"id":"pill/find","k":"pill","n":"찾기 / 탐색","a":["F"],"d":"이름/클래스로 검색\n층/유형으로 필터\n음성 검색 (마이크)\n요소로 이동","h":"Count elements\nviewer.counts\nList clashes between two disciplines\nviewer.clashes\nThe cost of a selection of a building\nviewer.cost","go":{"hkey":"find"}},{"id":"pill/fly","k":"pill","n":"비행 투어","a":["L"],"go":{"hkey":"fly"}},{"id":"pill/fullscreen","k":"pill","n":"전체 화면","a":["F11"],"go":{"hkey":"fullscreen"}},{"id":"pill/gi-preview","k":"pill","n":"GI 미리보기 (AO)","a":["ALT+G"],"d":"N8AO 앰비언트 오클루전 (연구 시제품)\n데스크톱 전용 — 모바일에서는 비활성화 (메모리)","go":{"hkey":"gi-preview"}},{"id":"pill/hbaFM","k":"pill","n":"인력-자산","d":"운영 단계(7D) 콕핏 — 모델 하나, 렌즈마다 하나의 질문에 답함\n점유(임대 상태 포함) · 재실 · 유닛 분류 · 자산/IoT · 대시보드\n웨이크 인식: 이 건물에 데이터가 있는 렌즈만 활성화 (나머지는 회색)\n모두 하나의 서명된 작업 로그 기반; 렌즈를 끄면 모델 복원","go":{"hkey":"hbaFM"}},{"id":"pill/help","k":"pill","n":"도움말","a":["F1"],"go":{"hkey":"help"}},{"id":"pill/home","k":"pill","n":"홈","go":{"hkey":"home"}},{"id":"pill/inspect","k":"pill","n":"검사","go":{"hkey":"inspect"}},{"id":"pill/issues","k":"pill","n":"이슈","a":["I"],"d":"스냅 사진 + 주석\n간섭 딥링크로 이동\nExcel 내보내기","go":{"hkey":"issues"}},{"id":"pill/key:'","k":"pill","n":"호버 이름","a":["'"],"go":{"hkey":"key:'"}},{"id":"pill/key:+","k":"pill","n":"확대","a":["+"],"go":{"hkey":"key:+"}},{"id":"pill/key:-","k":"pill","n":"축소","a":["-"],"go":{"hkey":"key:-"}},{"id":"pill/key:ALT+C","k":"pill","n":"MaxQ 영상","a":["ALT+C"],"go":{"hkey":"key:ALT+C"}},{"id":"pill/key:ALT+P","k":"pill","n":"배치 (사람 + 나무)","a":["ALT+P"],"go":{"hkey":"key:ALT+P"}},{"id":"pill/lod400","k":"pill","n":"LOD400 업그레이드","d":"중복 정점 용접 + 곡면 매끄럽게\n삼각형, 면적, 크기는 동일; 정점은 더 적게\n집계 및 기록됨; 유지하려면 저장","go":{"hkey":"lod400"}},{"id":"pill/measure","k":"pill","n":"측정","a":["M"],"go":{"hkey":"measure"}},{"id":"pill/navigate","k":"pill","n":"탐색","go":{"hkey":"navigate"}},{"id":"pill/night","k":"pill","n":"야간","a":["N"],"go":{"hkey":"night"}},{"id":"pill/open","k":"pill","n":"건물 열기","a":["CTRL+O"],"d":"저장된 .db 파일 열기\n기본 열기… 대화상자\n현재 장면을 교체","go":{"hkey":"open"}},{"id":"pill/palette","k":"pill","n":"팔레트","a":["P"],"d":"분위기 0–100\n태양 0–5\n노출 0.1–3\n주변광 0–2\n반구광 0–2\n야간\n그림자 + 지면 (순환)\n배경 반전\n효과음","go":{"hkey":"palette"}},{"id":"pill/precision","k":"pill","n":"정밀 (미세)","a":["CAPS LOCK"],"go":{"hkey":"precision"}},{"id":"pill/report","k":"pill","n":"4D / 5D","a":["4"],"go":{"hkey":"report"}},{"id":"pill/roadreport","k":"pill","n":"도로 보고서","a":["R"],"d":"선형 및 편차\n토공\n기하 상태\n표지 · 환경\n복사 / .txt / PDF","go":{"hkey":"roadreport"}},{"id":"pill/roadstd","k":"pill","n":"도로 기준","a":["J"],"d":"표지 코드 대 ATJ 2A/85\nOK / UNKNOWN / MISSING 트리\n표지 클릭: 확대 + 기준","go":{"hkey":"roadstd"}},{"id":"pill/roleFilter","k":"pill","n":"역할 보기","a":["D"],"d":"직종 프리셋 순환 (배관공/전기공/ACMV/구조/청소원)\n3D 장면과 아웃라이너를 해당 역할의 공종으로 필터\n편의용 필터일 뿐 — 접근 제어 아님","go":{"hkey":"roleFilter"}},{"id":"pill/rw","k":"pill","n":"도로 공사","a":["K"],"d":"시거 · 반경 · 도로 시설물: 보류","go":{"hkey":"rw"}},{"id":"pill/sanity","k":"pill","n":"정합성 검사","a":["Y"],"d":"떠 있는 부재 (STR 보)\n스팬/깊이 (참고)\n기둥 연속성","go":{"hkey":"sanity"}},{"id":"pill/save","k":"pill","n":"내보내기","a":["CTRL+S"],"d":"건물 (.db): 건물 저장과 동일, Ctrl+S\nIFC (건물 전체): 다른 BIM 도구용 .ifc 파일\nBCF (이슈): 저장된 이슈를 .bcfzip으로, 이슈가 생길 때까지 회색\n공정표 (MSP / PMXML / XER): MS Project 또는 Primavera P6용 시공 공정표, Time Machine이 만들기 전까지 회색\n5D 비용: 4D/5D 페이지의 비용 통합 문서 (.xlsx)","go":{"hkey":"save"}},{"id":"pill/sched4d","k":"pill","n":"4D 창","d":"선택한 요소 옆에 작업 이름 + 시작→종료\n직종 + 여유, 주공정 표시\n호버 시 한 줄 추가\n아직 공정표가 없나요? 탭하면 즉시 생성","go":{"hkey":"sched4d"}},{"id":"pill/section","k":"pill","n":"단면 절단","a":["X"],"d":"Y축 (수직)\nX축 (가로)\nZ축 (깊이)\n슬라이더 0–100%\n북마크","go":{"hkey":"section"}},{"id":"pill/settings","k":"pill","n":"설정","a":["="],"go":{"hkey":"settings"}},{"id":"pill/shadow","k":"pill","n":"그림자 + 지면","a":["H"],"go":{"hkey":"shadow"}},{"id":"pill/share","k":"pill","n":"공유","a":["/"],"go":{"hkey":"share"}},{"id":"pill/tm","k":"pill","n":"타임머신","a":["T"],"d":"간트 타임라인\n4D 공정표 작성 (✎)\nWhat-if (단계 밀기)\n시퀀스 재생 / 일시정지\n단계 슬라이더\n?tm=play 링크 공유","h":"Schedule state at a day\nviewer.schedule_at","go":{"hkey":"tm"}},{"id":"pill/walk","k":"pill","n":"걷기","go":{"hkey":"walk"}},{"id":"pill/whwalk","k":"pill","n":"피킹 경로","d":"로케이터 경로 (보행 순서)\n다음 빈으로 이동, FIND 렌즈 깊이\n빈 QR 스캔 / 코드 입력\n빈별 서명된 피킹 그룹","go":{"hkey":"whwalk"}},{"id":"pill/worldhist","k":"pill","n":"전체 기록","a":["W"],"d":"모든 페이지의 기록 — 뷰어, iDempiere, Gravity\n전체 | 이 페이지 전환\n일 단위 막대 — 하루씩 뒤로/앞으