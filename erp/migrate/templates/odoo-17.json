{
  "template": "odoo-17",
  "version": 1,
  "source": "Odoo 17 (XML-RPC), through the Odoo agent's odoo_export.json",
  "description": "The open balances at the cut-over (bim-compiler prompts/MIGRATE_INSTALL_TENANT.md §E3C-SPEC, W-MIGRATE-ENGINE ODOO-OPEN-*): the trial balance as ONE opening GL journal, with the receivable / payable / bank accounts routed to clearing accounts, and every open customer / vendor invoice and credit note as ONE-line documents on an Opening Charge whose account is that clearing account. The 17 master sheets are the Odoo agent's mapping re-expressed as data (bim-compiler prompts/MIGRATE_INSTALL_TENANT.md §ODOO-ENGINE-SPEC step O2), proven equal to the frozen hand mapping erp/tests/fixtures/odoo_convert_reference.mjs by W-MIGRATE-ENGINE ODOO-GUIDE / ODOO-DIFF / ODOO-MUTANT; the bridge set partner_keys goes away at the next step.",
  "connector": {"kind": "export-json", "format": "odoo-export-json-v1", "reportAs": "odoo_sets", "notThisFile": "This is not a file the Odoo agent wrote (odoo_export.json, format odoo-export-json-v1). Run the current export.js again: it writes it beside the workbook."},
  "srcKey": "odoo",
  "variables": {
    "AR_CLEARING": "AR-CLEAR",
    "AP_CLEARING": "AP-CLEAR",
    "BANK_CLEARING": "BANK-CLEAR",
    "CHARGE_AR": "Opening Charge AR",
    "CHARGE_AP": "Opening Charge AP",
    "TAX_NONE": "OPEN-0"
  },
  "valueMaps": {
    "acctClass": {"asset_receivable": "AR", "liability_payable": "AP", "asset_cash": "BANK"},
    "docType": {"out_invoice": "AR Invoice", "out_refund": "AR Credit Memo", "in_invoice": "AP Invoice", "in_refund": "AP CreditMemo"},
    "isSO": {"out_invoice": "Y", "out_refund": "Y", "in_invoice": "N", "in_refund": "N"},
    "sign": {"out_invoice": 1, "out_refund": -1, "in_invoice": -1, "in_refund": 1}
  },
  "defs": {
    "bal": {"round": ["$balance", "@manifest.currency_places"]},
    "class": {"str": {"map": ["acctClass", {"find": ["account.account", "id", "$account_id", "account_type"]}]}},
    "clearing": {"if": [{"eq": [{"def": "class"}, "AR"]}, "${AR_CLEARING}", {"if": [{"eq": [{"def": "class"}, "AP"]}, "${AP_CLEARING}", {"if": [{"eq": [{"def": "class"}, "BANK"]}, "${BANK_CLEARING}", ""]}]}]},
    "isInvoice": {"in": [{"str": "$move_type"}, ["out_invoice", "out_refund", "in_invoice", "in_refund"]]},
    "foreign": {"ne": [{"str": "$currency_id"}, {"str": "$company_currency_id"}]},
    "oPartner": {"at": [{"findAll": ["res.partner", "id", "$partner_id"]}, 0]},
    "held": {"str": {"with": [{"def": "oPartner"}, {"def": "pHeld"}]}},
    "bpValue": {"str": {"with": [{"def": "oPartner"}, {"def": "pBpKey"}]}},
    "notBroughtIn": {"or": [{"not": {"def": "isInvoice"}}, {"def": "foreign"}, {"def": "held"}, {"not": {"def": "bpValue"}}, {"gt": [{"len": {"str": "$move_name"}}, 30]}]},
    "cutCell": {"concat": ["cut to ", "#L", " characters"]},
    "cutRule": {"concat": ["legacy PO.set_Value cuts a value longer than the column (PO.java:1079-1082); Odoo ids ", "#ids"]},
    "keysRule": {"concat": ["the ERP needs one ", "#col", " per company (unique index) and at most ", "#L", " characters; Odoo has ", {"join": [{"each": ["#items", {"concat": [{"json": "$odoo"}, " → ", {"json": "$erp"}, " (", "$why", ")"]}]}, "; "]}]},
    "precP": {"round": [{"mul": [-1, {"log10": "$rounding"}]}, 0]},
    "prec": {"if": [{"gt": ["$rounding", 0]}, {"if": [{"lt": [{"def": "precP"}, 0]}, 0, {"def": "precP"}]}, ""]},
    "tLines": {"findAll": ["account.payment.term.line", "payment_id", "$id"]},
    "acctType": {"if": [{"re": ["^asset", "", "$account_type", 0]}, "A", {"if": [{"re": ["^liability", "", "$account_type", 0]}, "L", {"if": [{"re": ["^equity", "", "$account_type", 0]}, "O", {"if": [{"re": ["^income", "", "$account_type", 0]}, "R", {"if": [{"re": ["^expense", "", "$account_type", 0]}, "E", {"if": [{"eq": ["$account_type", "off_balance"]}, "M", ""]}]}]}]}]}]},
    "prodType": {"if": [{"eq": ["$detailed_type", "service"]}, "S", {"if": [{"in": ["$detailed_type", ["consu", "product"]]}, "I", ""]}]},
    "coCountry": {"or": ["@manifest.company_country_code", ""]},
    "pTopRow": {"or": [{"at": [{"findAll": ["res.partner", "id", "$commercial_partner_id"]}, 0]}, "$"]},
    "pTopId": {"with": [{"def": "pTopRow"}, "$id"]},
    "pSelfInt": {"if": [{"has": {"find": ["res.company", "partner_id", "$id", "id"]}}, "company", {"if": [{"has": {"find": ["res.users", "partner_id", "$id", "id"]}}, "user", ""]}]},
    "pTopInt": {"with": [{"def": "pTopRow"}, {"def": "pSelfInt"}]},
    "pHeld": {"or": [{"def": "pSelfInt"}, {"def": "pTopInt"}]},
    "pHeldWhy": {"if": [{"def": "pSelfInt"}, {"concat": ["internal-", {"def": "pSelfInt"}]}, {"concat": ["contact of internal-", {"def": "pTopInt"}]}]},
    "pIsTop": {"eq": [{"def": "pTopId"}, "$id"]},
    "pHasAddr": {"or": ["$street", "$street2", "$city", "$zip", "$country_id"]},
    "pLocOk": {"and": [{"not": {"def": "pHeld"}}, {"def": "pHasAddr"}, {"or": [{"def": "pIsTop"}, {"and": ["$type", {"ne": ["$type", "contact"]}]}]}]},
    "pBpKey": {"key": ["bpKey", {"def": "pTopId"}]},
    "pUU": {"uuid5": {"concat": ["@manifest.db", "/res.partner/", "$id"]}},
    "vendorK": {"with": [{"at": [{"findAll": ["res.partner", "id", "$partner_id"]}, 0]}, {"or": [{"key": ["bpKey", {"def": "pTopId"}]}, ""]}]},
    "whOfQ": {"find": ["stock.warehouse", "id", {"find": ["stock.location", "id", "$location_id", "warehouse_id"]}, "id"]},
    "locWh": {"if": ["$warehouse_id", {"or": [{"find": ["stock.warehouse", "id", "$warehouse_id", "code"]}, ""]}, ""]},
    "locXyz": {"concat": [{"def": "locWh"}, "|", "$posx", "|", "$posy", "|", "$posz"]},
    "tbSum": {"sumSet": ["tb", true, "$balance"]},
    "negQ": {"filter": [{"all": "stock.quant"}, {"lt": ["$quantity", 0]}]}
  },
  "entities": {
    "C_UOM": { "from": "uom.uom",
      "fields": {"Name": "$name", "UOMSymbol": {"cut": ["$name", 10]}, "StdPrecision": {"def": "prec"}, "X12DE355": ""},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Name": 60, "UOMSymbol": 10}},
      "prov": {"model": "uom.uom", "id": "$id", "category": {"if": ["$category_id", "$category_id__name", false]}, "uom_type": "$uom_type", "factor": "$factor"},
      "patches": [{"column": "X12DE355", "cell": "(blank)", "rule": "no Odoo field: the ERP \"Migrate from Odoo\" form maps each Odoo UoM to an iDempiere UoM (§B4-SPEC step 2)", "rows": {"count": "C_UOM"}, "zero": true}] },
    "C_PaymentTerm": { "from": "account.payment.term",
      "fields": {"Value": {"cut": ["$name", 40]}, "Name": "$name", "NetDays": {"if": [{"eq": [{"len": {"def": "tLines"}}, 1]}, {"find": ["account.payment.term.line", "payment_id", "$id", "nb_days"]}, ""]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Value": 40, "Name": 60}},
      "prov": {"model": "account.payment.term", "id": "$id", "lines": {"each": [{"def": "tLines"}, ["$value", "$value_amount", "$nb_days"]]}},
      "notes": [{"when": {"countWhere": ["C_PaymentTerm", {"gt": [{"len": {"def": "tLines"}}, 1]}]}, "text": {"concat": [{"countWhere": ["C_PaymentTerm", {"gt": [{"len": {"def": "tLines"}}, 1]}]}, " payment term(s) have several installments (", {"join": [{"collect": ["C_PaymentTerm", {"gt": [{"len": {"def": "tLines"}}, 1]}, "$name"]}, "; "]}, "): imported as the term only; the installments are in provenance.json for C_PaySchedule."]}}] },
    "M_Product_Category": { "from": "product.category",
      "sort": {"add": [{"mul": [{"len": {"split": ["$complete_name", " / "]}}, 1000000000]}, "$id"]},
      "keys": {"col": "Value", "id": "$id", "raw": "$complete_name", "max": 40, "as": "catKey", "patch": {"cell": "<code>-<odoo id> or <cut>~<odoo id>", "rule": {"def": "keysRule"}}},
      "fields": {"Value": "#ukey", "Name": "$name", "M_Product_Category_Parent_ID>Value": {"if": ["$parent_id", {"key": ["catKey", "$parent_id"]}, ""]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Value": 40, "Name": 60}},
      "prov": {"model": "product.category", "id": "$id"} },
    "C_ElementValue": { "from": "account.account",
      "fields": {"Value": "$code", "Name": "$name", "AccountType": {"def": "acctType"}, "AccountSign": "N", "IsSummary": "N", "C_Element_ID>ElementType": "A"},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Value": 40, "Name": 120}},
      "prov": {"model": "account.account", "id": "$id", "account_type": "$account_type"},
      "patches": [{"column": "C_Element_ID", "cell": "C_Element_ID>ElementType = A", "rule": "ImportAccount.java:130-143 — the account element of the tenant (legacy: the element the user names)", "rows": {"count": "C_ElementValue"}, "zero": true}],
      "notes": [{"when": {"not": {"meta": ["account.group", "count"]}}, "text": "account.group has 0 rows: the chart of accounts imports flat (no summary parents in the source)."}] },
    "C_BPartner": { "from": "res.partner",
      "where": {"and": [{"not": {"def": "pHeld"}}, {"def": "pIsTop"}]},
      "keys": {"col": "Value", "id": "$id", "raw": {"or": ["$ref", {"str": "$id"}]}, "max": 40, "as": "bpKey", "patch": {"cell": "<code>-<odoo id> or <cut>~<odoo id>", "rule": {"def": "keysRule"}}},
      "fields": {"Value": "#ukey", "Name": "$name", "TaxID": "$vat", "IsCustomer": {"if": [{"gt": ["$customer_rank", 0]}, "Y", "N"]}, "IsVendor": {"if": [{"gt": ["$supplier_rank", 0]}, "Y", "N"]}, "C_BP_Group_ID>IsDefault": "Y", "IsActive": {"if": ["$active", "Y", "N"]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Value": 40, "Name": 120, "TaxID": 20}},
      "prov": {"model": "res.partner", "id": "$id", "part": "partner", "active": "$active"},
      "patches": [{"column": "C_BP_Group_ID", "cell": "C_BP_Group_ID>IsDefault = Y", "rule": "ImportBPartner.java:129-132 — the client's default business partner group", "rows": {"count": "C_BPartner"}, "zero": true}] },
    "C_Location": { "from": {"let": "LOCP"},
      "once": "$id",
      "fields": {"Address1": "$street", "Address2": "$street2", "City": "$city", "Postal": "$zip", "RegionName": {"if": ["$state_id", {"find": ["res.country.state", "id", "$state_id", "name"]}, ""]}, "C_Country_ID>CountryCode": {"if": ["$country_id", {"find": ["res.country", "id", "$country_id", "code"]}, {"def": "coCountry"}]}, "C_Location_UU": {"def": "pUU"}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Address1": 60, "Address2": 60, "City": 60, "Postal": 10, "RegionName": 40}},
      "prov": {"model": "res.partner", "id": "$id", "part": "address"},
      "patches": [{"column": "C_Location_UU", "cell": "UUID v5 of \"<db>/res.partner/<id>\"", "rule": "iDempiere's record key for moving data between systems (2Pack resolves by the _UU column): the address is found by it, not by its street", "rows": {"count": "C_Location"}, "zero": true}, {"column": "C_Country_ID", "cell": {"concat": ["your Odoo company's country (", {"def": "coCountry"}, ")"]}, "rule": {"concat": ["C_Location.C_Country_ID is mandatory; Odoo left the country empty on res.partner ", {"join": [{"collect": ["C_Location", {"not": "$country_id"}, "$id"]}, ", "]}, " — check them after the move"]}, "rows": {"countWhere": ["C_Location", {"not": "$country_id"}]}}] },
    "C_BPartner_Location": { "from": "res.partner",
      "where": {"and": [{"def": "pLocOk"}, {"def": "pBpKey"}]},
      "fields": {"C_BPartner_ID>Value": {"def": "pBpKey"}, "C_Location_ID>C_Location_UU": {"def": "pUU"}, "Name": {"if": [{"and": ["$type", {"ne": ["$type", "contact"]}]}, {"or": ["$name", "$type"]}, ""]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Name": 60}},
      "prov": {"model": "res.partner", "id": "$id", "part": "bp-location", "type": {"or": ["$type", "contact"]}} },
    "AD_User": { "from": "res.partner",
      "where": {"and": [{"not": {"def": "pHeld"}}, {"not": {"def": "pIsTop"}}]},
      "fields": {"Name": "$name", "EMail": "$email", "Phone": "$phone", "Phone2": "$mobile", "C_BPartner_ID>Value": {"def": "pBpKey"}, "IsActive": {"if": ["$active", "Y", "N"]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Name": 60, "EMail": 60, "Phone": 40, "Phone2": 40}},
      "prov": {"model": "res.partner", "id": "$id", "part": "contact", "type": "$type", "parent": {"or": ["$parent_id", null]}, "active": "$active"},
      "notes": [{"when": {"gt": [{"add": [{"countWhere": ["C_BPartner", {"eq": ["!IsActive", "N"]}]}, {"countWhere": ["AD_User", {"eq": ["!IsActive", "N"]}]}]}, 0]}, "text": {"concat": [{"add": [{"countWhere": ["C_BPartner", {"eq": ["!IsActive", "N"]}]}, {"countWhere": ["AD_User", {"eq": ["!IsActive", "N"]}]}]}, " partner(s)/contact(s) are archived in Odoo: they come in INACTIVE (kept for history; nobody can pick them on new documents)."]}}] },
    "M_Product": { "from": "product.product",
      "keys": {"col": "Value", "id": "$id", "raw": {"or": ["$default_code", {"str": "$id"}]}, "max": 510, "as": "prodKey", "patch": {"cell": "<code>-<odoo id> or <cut>~<odoo id>", "rule": {"def": "keysRule"}}},
      "fields": {"Value": "#ukey", "Name": "$name", "Description": "$description", "M_Product_Category_ID>Value": {"or": [{"key": ["catKey", "$categ_id"]}, ""]}, "C_UOM_ID": {"if": ["$uom_id", "$uom_id__name", ""]}, "ProductType": {"def": "prodType"}, "UPC": "$barcode", "Weight": "$weight", "Volume": "$volume", "C_TaxCategory_ID>IsDefault": "Y", "IsActive": {"if": ["$active", "Y", "N"]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Value": 510, "Name": 255, "Description": 255, "UPC": 30}},
      "prov": {"model": "product.product", "id": "$id", "active": "$active"},
      "patches": [{"column": "C_TaxCategory_ID", "cell": "C_TaxCategory_ID>IsDefault = Y", "rule": "ImportProduct.java:415 — the client's default tax category", "rows": {"count": "M_Product"}, "zero": true}],
      "notes": [{"when": {"gt": [{"countWhere": ["M_Product", {"eq": ["!IsActive", "N"]}]}, 0]}, "text": {"concat": [{"countWhere": ["M_Product", {"eq": ["!IsActive", "N"]}]}, " product(s) are archived in Odoo: they come in INACTIVE (their stock and vendor prices keep a product to point at)."]}}] },
    "M_Product_PO": { "from": {"of": "M_Product", "list": {"sortBy": [{"cat": [{"findAll": ["product.supplierinfo", "product_id", "$id"]}, {"filter": [{"findAll": ["product.supplierinfo", "product_tmpl_id", "$product_tmpl_id"]}, {"not": "$product_id"}]}]}, ["$min_qty", "$id"]]}},
      "group": {"by": [{"def": "vendorK"}], "within": true, "sort": true},
      "fields": {"M_Product_ID>Value": "&Value", "C_BPartner_ID>Value": {"def": "vendorK"}, "PricePO": "$price", "VendorProductNo": {"or": ["$product_code", "&Value"]}, "Order_Min": "$min_qty", "DeliveryTime_Promised": "$delay"},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"VendorProductNo": 40}},
      "prov": {"model": "product.supplierinfo", "id": "$id", "ids": {"each": ["#members", "$id"]}, "product": "^id"},
      "patches": [{"column": "VendorProductNo", "cell": "the product's Value", "rule": "ImportProduct.java:393-394 — VendorProductNo=Value when the vendor gave none", "rows": {"countWhere": ["M_Product_PO", {"and": [{"has": "#members"}, {"not": "$product_code"}]}]}}],
      "notes": [{"when": {"gt": [{"len": {"collect": ["M_Product_PO", {"and": [{"has": "#members"}, {"gt": [{"len": "#members"}, 1]}]}, {"concat": ["!M_Product_ID>Value", "/", "!C_BPartner_ID>Value", " ×", {"len": "#members"}]}]}}, 0]}, "text": {"concat": [{"len": {"collect": ["M_Product_PO", {"and": [{"has": "#members"}, {"gt": [{"len": "#members"}, 1]}]}, {"concat": ["!M_Product_ID>Value", "/", "!C_BPartner_ID>Value", " ×", {"len": "#members"}]}]}}, " product/vendor pair(s) have Odoo quantity price breaks (", {"join": [{"collect": ["M_Product_PO", {"and": [{"has": "#members"}, {"gt": [{"len": "#members"}, 1]}]}, {"concat": ["!M_Product_ID>Value", "/", "!C_BPartner_ID>Value", " ×", {"len": "#members"}]}]}, ", "]}, "): the lowest-quantity price is the vendor price; the breaks are in provenance.json (M_ProductPriceVendorBreak is not in this set)."]}}] },
    "M_PriceList": { "from": {"let": "ONE"},
      "fields": {"Name": "Odoo list_price", "IsSOPriceList": "Y", "C_Currency_ID>ISO_Code": "@manifest.currency"},
      "prov": {"model": "product.product", "field": "list_price"},
      "patches": [{"column": "Name", "cell": "Odoo list_price", "rule": "Odoo keeps the sale price on the product (list_price), not in a named list: one list named after that field", "rows": 1}] },
    "M_PriceList_Version": { "from": {"let": "ONE"},
      "fields": {"M_PriceList_ID": "Odoo list_price", "Name": "@manifest.cutover", "ValidFrom": "@manifest.cutover", "M_DiscountSchema_ID>DiscountType": "P"},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Name": 60}},
      "prov": {"cutover": "@manifest.cutover"},
      "patches": [{"column": "Name", "cell": "@manifest.cutover", "rule": "the cutover date — what the AD default @#Date@ gives a new version in the window", "rows": 1}, {"column": "M_DiscountSchema_ID", "cell": "M_DiscountSchema_ID>DiscountType = P", "rule": "ImportPriceList.java:97-98 — the first price-list schema of the client", "rows": 1}] },
    "M_ProductPrice": { "from": "product.product",
      "fields": {"M_PriceList_Version_ID": "@manifest.cutover", "M_Product_ID>Value": {"key": ["prodKey", "$id"]}, "PriceList": "$list_price", "PriceStd": "$list_price"},
      "prov": {"model": "product.product", "id": "$id", "field": "list_price"} },
    "M_Warehouse": { "from": "stock.warehouse",
      "fields": {"Value": "$code", "Name": "$name", "C_Location_ID>C_Location_UU": {"with": [{"at": [{"findAll": ["res.partner", "id", "$partner_id"]}, 0]}, {"if": [{"def": "pHasAddr"}, {"def": "pUU"}, ""]}]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Value": 40, "Name": 60}},
      "prov": {"model": "stock.warehouse", "id": "$id", "partner": {"or": ["$partner_id", null]}} },
    "M_Locator": { "from": "stock.location",
      "keys": {"col": "Value", "id": "$id", "raw": "$complete_name", "max": 40, "as": "locKey", "patch": {"cell": "<code>-<odoo id> or <cut>~<odoo id>", "rule": {"def": "keysRule"}}},
      "fields": {"M_Warehouse_ID>Value": {"def": "locWh"}, "Value": "#ukey", "X": {"str": "$posx"}, "Y": {"str": "$posy"}, "Z": {"if": [{"exists": ["M_Locator", "_xyz", {"def": "locXyz"}]}, {"str": "$id"}, {"str": "$posz"}]}, "IsActive": {"if": ["$active", "Y", "N"]}, "_xyz": {"def": "locXyz"}, "_zfix": {"if": [{"exists": ["M_Locator", "_xyz", {"def": "locXyz"}]}, "Y", "N"]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"Value": 40, "X": 60, "Y": 60, "Z": 60}},
      "prov": {"model": "stock.location", "id": "$id", "posz": "$posz", "active": "$active"},
      "patches": [{"column": "Z", "cell": "the Odoo stock.location id", "rule": "legacy unique index m_location_where (M_Warehouse_ID, X, Y, Z); Odoo repeats posx/posy/posz within the warehouse", "rows": {"countWhere": ["M_Locator", {"eq": ["!_zfix", "Y"]}]}}] },
    "M_Inventory": { "from": "stock.warehouse",
      "where": {"in": ["$id", "%HS"]},
      "fields": {"DocumentNo": {"concat": ["OPEN-", "$code", "-", "@manifest.cutover"]}, "M_Warehouse_ID>Value": "$code", "MovementDate": "@manifest.cutover", "C_DocType_ID>DocSubTypeInv": "PI", "Description": {"concat": ["Opening stock from Odoo ", "@manifest.db", " at ", "@manifest.cutover"]}},
      "limit": {"id": "$id", "cell": {"def": "cutCell"}, "rule": {"def": "cutRule"}, "cols": {"DocumentNo": 30, "Description": 255}},
      "prov": {"model": "stock.warehouse", "id": "$id"},
      "patches": [{"column": "C_DocType_ID", "cell": "C_DocType_ID>DocSubTypeInv = PI", "rule": "MInventory.java:301-304 refuses none; MSetup.java:776 makes ONE Physical Inventory type (DocBaseType MMI, DocSubTypeInv PI) — MMI alone also matches Internal Use and Cost Adjustment", "rows": {"count": "M_Inventory"}, "zero": true}, {"column": "DocumentNo", "cell": "OPEN-<warehouse>-<cutover>", "rule": "the lines find their header by DocumentNo (Ninja MigrateExcelData Line rule); legacy would number it from the sequence", "rows": {"count": "M_Inventory"}, "zero": true}] },
    "M_InventoryLine": { "from": "stock.quant",
      "group": {"by": ["$location_id", "$product_id"], "sum": {"QtyCount": {"of": "$quantity", "places": 6}}},
      "fields": {"M_Inventory_ID": {"if": [{"has": {"def": "whOfQ"}}, {"concat": ["OPEN-", {"find": ["stock.warehouse", "id", {"def": "whOfQ"}, "code"]}, "-", "@manifest.cutover"]}, ""]}, "M_Locator_ID>Value": {"or": [{"key": ["locKey", "$location_id"]}, ""]}, "M_Product_ID>Value": {"or": [{"key": ["prodKey", "$product_id"]}, ""]}},
      "prov": {"model": "stock.quant", "ids": {"each": ["#members", "$id"]}, "lots": {"each": [{"filter": ["#members", "$lot_id"]}, "$lot_id__name"]}, "cost": {"if": [{"has": {"find": ["product.product", "id", "$product_id", "id"]}}, {"find": ["product.product", "id", "$product_id", "standard_price"]}, null]}},
      "notes": [{"when": {"gt": [{"len": {"collect": ["M_InventoryLine", {"and": [{"has": "#members"}, {"gt": [{"len": "#members"}, 1]}]}, {"concat": ["!M_Product_ID>Value", " ×", {"len": "#members"}]}]}}, 0]}, "text": {"concat": [{"len": {"collect": ["M_InventoryLine", {"and": [{"has": "#members"}, {"gt": [{"len": "#members"}, 1]}]}, {"concat": ["!M_Product_ID>Value", " ×", {"len": "#members"}]}]}}, " stock line(s) sum several Odoo quants of one product in one location (lots: ", {"join": [{"collect": ["M_InventoryLine", {"and": [{"has": "#members"}, {"gt": [{"len": "#members"}, 1]}]}, {"concat": ["!M_Product_ID>Value", " ×", {"len": "#members"}]}]}, ", "]}, ")."]}}, {"when": {"gt": [{"len": {"filter": [{"all": "stock.quant"}, "$lot_id"]}}, 0]}, "text": {"concat": [{"len": {"filter": [{"all": "stock.quant"}, "$lot_id"]}}, " stock line(s) carry an Odoo lot (in provenance.json): the lot → attribute set instance step is not in this set yet."]}}, {"when": {"gt": [{"len": {"def": "negQ"}}, 0]}, "text": {"concat": [{"len": {"def": "negQ"}}, " stock line(s) are NEGATIVE in Odoo (", {"join": [{"each": [{"def": "negQ"}, {"if": [{"has": {"find": ["product.product", "id", "$product_id", "id"]}}, {"key": ["prodKey", "$product_id"]}, "$id"]}]}, ", "]}, "): exported as Odoo has them; the summary screen shows them."]}}, {"when": {"or": [{"gt": [{"abs": {"def": "tbSum"}}, 0.005]}, {"eq": [{"abs": {"def": "tbSum"}}, 0.005]}]}, "text": {"concat": ["The trial balance at ", "@manifest.cutover", " does not sum to zero (", {"fixed": [{"def": "tbSum"}, 2]}, "): the opening journal will be refused as unbalanced until that is explained."]}}, {"when": {"gt": [{"len": "@manifest.other_companies"}, 0]}, "text": {"concat": ["This Odoo has ", {"add": [{"len": "@manifest.other_companies"}, 1]}, " companies; this export is ONLY ", {"json": {"find": ["res.company", "id", "@manifest.company_id", "name"]}}, ". Each company moves into its own ERP company — export the others with: ", {"join": ["@manifest.other_company_commands", " | "]}]}}] },
    "I_GLJournal": { "from": "tb",
      "where": {"ne": [{"def": "bal"}, 0]},
      "fields": {"BatchDocumentNo": {"concat": ["OPEN-TB-", "@manifest.cutover"]}, "BatchDescription": {"cut": [{"concat": ["Opening balances from Odoo ", "@manifest.db", " at ", "@manifest.cutover"]}, 255]}, "JournalDocumentNo": {"concat": ["OPEN-TB-", "@manifest.cutover"]}, "DocTypeName": "GL Journal", "CategoryName": "Manual", "PostingType": "A", "DateAcct": "@manifest.cutover", "ISO_Code": "@manifest.currency", "AccountValue": {"first": [{"def": "clearing"}, {"find": ["account.account", "id", "$account_id", "code"]}]}, "AmtSourceDr": {"if": [{"gt": [{"def": "bal"}, 0]}, {"def": "bal"}, 0]}, "AmtSourceCr": {"if": [{"lt": [{"def": "bal"}, 0]}, {"abs": {"def": "bal"}}, 0]}, "Description": {"cut": [{"concat": ["Opening balance of ", "$account_id__name"]}, 255]}, "I_IsImported": "N"},
      "prov": {"odoo": "account.move.line (read_group by account)", "account": "$account_id", "lines": "$__count"} },
    "I_Invoice": { "from": "open_lines",
      "refuse": [{"when": {"not": {"def": "isInvoice"}}, "why": "an open receivable / payable line of a journal entry that is not an invoice (an unallocated payment or a manual entry): not brought in yet — its amount stays on the clearing account"}, {"when": {"def": "foreign"}, "why": "an open item in a foreign currency: not brought in yet — its amount stays on the clearing account"}, {"when": {"def": "held"}, "why": "the open item's partner is your own company or an internal user (held, not a business partner)"}, {"when": {"not": {"def": "bpValue"}}, "why": "the open item's partner has no business partner in the workbook"}, {"when": {"gt": [{"len": {"str": "$move_name"}}, 30]}, "why": "the document number is longer than 30 characters"}],
      "group": {"by": ["$move_id"], "sum": {"PriceActual": {"of": {"mul": ["$amount_residual", {"map": ["sign", "$move_type"]}]}}}},
      "fields": {"DocumentNo": {"str": "$move_name"}, "DocTypeName": {"map": ["docType", "$move_type"]}, "IsSOTrx": {"map": ["isSO", "$move_type"]}, "BPartnerValue": {"def": "bpValue"}, "DateInvoiced": {"first": ["$invoice_date", "$date"]}, "DateAcct": "@manifest.cutover", "ISO_Code": "@manifest.currency", "PaymentTermValue": {"cut": [{"str": {"find": ["open_moves", "id", "$move_id", "invoice_payment_term_id__name"]}}, 40]}, "ChargeName": {"if": [{"eq": [{"map": ["isSO", "$move_type"]}, "Y"]}, "${CHARGE_AR}", "${CHARGE_AP}"]}, "QtyOrdered": 1, "TaxIndicator": "${TAX_NONE}", "Description": {"cut": [{"concat": ["Open item from Odoo: ", "$move_name"]}, 255]}, "I_IsImported": "N"},
      "prov": {"odoo": "account.move", "id": "$move_id", "name": "$move_name"},
      "notes": [{"when": {"any": ["open_lines", {"def": "notBroughtIn"}]}, "text": {"concat": ["Open lines NOT brought in — receivable ", {"round": [{"sumSet": ["open_lines", {"and": [{"def": "notBroughtIn"}, {"eq": [{"def": "class"}, "AR"]}]}, "$amount_residual"]}, "@manifest.currency_places"]}, ", payable ", {"round": [{"sumSet": ["open_lines", {"and": [{"def": "notBroughtIn"}, {"eq": [{"def": "class"}, "AP"]}]}, "$amount_residual"]}, "@manifest.currency_places"]}, " ", "@manifest.currency", " (debit +, credit −). Those amounts stay on the AR / AP clearing accounts until the lines are entered by hand."]}}] }
  },
  "manifest": {
    "tool": "migrate/templates/odoo-17.json",
    "format": "ninja-workbook-v3",
    "workbook": "odoo_migration.xlsx",
    "odoo_version": "@manifest.odoo_version",
    "db": "@manifest.db",
    "cutover": "@manifest.cutover",
    "currency": "@manifest.currency",
    "company": {"each": [{"filter": [{"all": "res.company"}, {"eq": ["$id", "@manifest.company_id"]}]}, "$name"]},
    "company_id": "@manifest.company_id",
    "other_companies": {"each": ["@manifest.other_companies", {"obj": {"id": "$id", "name": "$name"}}]},
    "source_counts": {"dict": {"each": [["uom.uom", "account.payment.term", "product.category", "account.account", "res.partner", "stock.warehouse", "product.product", "product.supplierinfo", "stock.location", "stock.quant"], [{"concat": [{"meta": ["$", "model"]}, " ", {"meta": ["$", "domain"]}, {"if": [{"meta": ["$", "archived_too"]}, " (archived too)", ""]}]}, {"meta": ["$", "count"]}]]}},
    "held": "%HELD",
    "self_check_fails": {"add": [{"if": [{"eq": [{"sumSet": ["tb", true, "$__count"]}, {"meta": ["tb", "count"]}]}, 0, 1]}, {"if": [{"eq": [{"add": [{"count": "C_BPartner"}, {"count": "AD_User"}, {"len": "%HELD"}]}, {"size": "res.partner"}]}, 0, 1]}, {"if": [{"eq": [{"count": "M_Product"}, {"size": "product.product"}]}, 0, 1]}, {"if": [{"eq": [{"countWhere": ["M_InventoryLine", true]}, {"size": "stock.quant"}]}, 0, 1]}, {"if": [{"eq": [{"add": [{"countWhere": ["M_Product_Category", {"and": [{"ne": ["!M_Product_Category_Parent_ID>Value", ""]}, {"ne": [{"tally": ["M_Product_Category", "Value", "!M_Product_Category_Parent_ID>Value"]}, 1]}]}]}, {"countWhere": ["C_BPartner_Location", {"or": [{"eq": ["!C_BPartner_ID>Value", ""]}, {"ne": [{"tally": ["C_BPartner", "Value", "!C_BPartner_ID>Value"]}, 1]}]}]}, {"countWhere": ["C_BPartner_Location", {"or": [{"eq": ["!C_Location_ID>C_Location_UU", ""]}, {"ne": [{"tally": ["C_Location", "C_Location_UU", "!C_Location_ID>C_Location_UU"]}, 1]}]}]}, {"countWhere": ["AD_User", {"or": [{"eq": ["!C_BPartner_ID>Value", ""]}, {"ne": [{"tally": ["C_BPartner", "Value", "!C_BPartner_ID>Value"]}, 1]}]}]}, {"countWhere": ["M_Product", {"or": [{"eq": ["!M_Product_Category_ID>Value", ""]}, {"ne": [{"tally": ["M_Product_Category", "Value", "!M_Product_Category_ID>Value"]}, 1]}]}]}, {"countWhere": ["M_Product", {"or": [{"eq": ["!C_UOM_ID", ""]}, {"ne": [{"tally": ["C_UOM", "Name", "!C_UOM_ID"]}, 1]}]}]}, {"countWhere": ["M_Product_PO", {"and": [{"has": "!M_Product_ID>Value"}, {"or": [{"eq": ["!M_Product_ID>Value", ""]}, {"ne": [{"tally": ["M_Product", "Value", "!M_Product_ID>Value"]}, 1]}]}]}]}, {"countWhere": ["M_Product_PO", {"and": [{"has": "!C_BPartner_ID>Value"}, {"or": [{"eq": ["!C_BPartner_ID>Value", ""]}, {"ne": [{"tally": ["C_BPartner", "Value", "!C_BPartner_ID>Value"]}, 1]}]}]}]}, {"countWhere": ["M_PriceList_Version", {"or": [{"eq": ["!M_PriceList_ID", ""]}, {"ne": [{"tally": ["M_PriceList", "Name", "!M_PriceList_ID"]}, 1]}]}]}, {"countWhere": ["M_ProductPrice", {"or": [{"eq": ["!M_PriceList_Version_ID", ""]}, {"ne": [{"tally": ["M_PriceList_Version", "Name", "!M_PriceList_Version_ID"]}, 1]}]}]}, {"countWhere": ["M_ProductPrice", {"or": [{"eq": ["!M_Product_ID>Value", ""]}, {"ne": [{"tally": ["M_Product", "Value", "!M_Product_ID>Value"]}, 1]}]}]}, {"countWhere": ["M_Warehouse", {"or": [{"eq": ["!C_Location_ID>C_Location_UU", ""]}, {"ne": [{"tally": ["C_Location", "C_Location_UU", "!C_Location_ID>C_Location_UU"]}, 1]}]}]}, {"countWhere": ["M_Locator", {"or": [{"eq": ["!M_Warehouse_ID>Value", ""]}, {"ne": [{"tally": ["M_Warehouse", "Value", "!M_Warehouse_ID>Value"]}, 1]}]}]}, {"countWhere": ["M_Inventory", {"or": [{"eq": ["!M_Warehouse_ID>Value", ""]}, {"ne": [{"tally": ["M_Warehouse", "Value", "!M_Warehouse_ID>Value"]}, 1]}]}]}, {"countWhere": ["M_InventoryLine", {"and": [{"has": "!M_Inventory_ID"}, {"or": [{"eq": ["!M_Inventory_ID", ""]}, {"ne": [{"tally": ["M_Inventory", "DocumentNo", "!M_Inventory_ID"]}, 1]}]}]}]}, {"countWhere": ["M_InventoryLine", {"and": [{"has": "!M_Locator_ID>Value"}, {"or": [{"eq": ["!M_Locator_ID>Value", ""]}, {"ne": [{"tally": ["M_Locator", "Value", "!M_Locator_ID>Value"]}, 1]}]}]}]}, {"countWhere": ["M_InventoryLine", {"and": [{"has": "!M_Product_ID>Value"}, {"or": [{"eq": ["!M_Product_ID>Value", ""]}, {"ne": [{"tally": ["M_Product", "Value", "!M_Product_ID>Value"]}, 1]}]}]}]}]}, 0]}, 0, 1]}]},
    "currency_places": "@manifest.currency_places",
    "clearing": {"obj": {"AR": "${AR_CLEARING}", "AP": "${AP_CLEARING}", "BANK": "${BANK_CLEARING}"}},
    "charges": {"obj": {"AR": "${CHARGE_AR}", "AP": "${CHARGE_AP}"}},
    "tax": "${TAX_NONE}",
    "left": {"obj": {"AR": {"round": [{"sumSet": ["open_lines", {"and": [{"def": "notBroughtIn"}, {"eq": [{"def": "class"}, "AR"]}]}, "$amount_residual"]}, "@manifest.currency_places"]}, "AP": {"round": [{"sumSet": ["open_lines", {"and": [{"def": "notBroughtIn"}, {"eq": [{"def": "class"}, "AP"]}]}, "$amount_residual"]}, "@manifest.currency_places"]}}}
  },
  "let": {
    "ONE": {"obj": {}},
    "HELD": {"each": [{"filter": [{"all": "res.partner"}, {"def": "pHeld"}]}, {"obj": {"model": "res.partner", "id": "$id", "name": "$name", "why": {"def": "pHeldWhy"}}}]},
    "LOCP": {"cat": [{"filter": [{"all": "res.partner"}, {"def": "pLocOk"}]}, {"filter": [{"each": [{"all": "stock.warehouse"}, {"at": [{"findAll": ["res.partner", "id", "$partner_id"]}, 0]}]}, {"and": ["$", {"def": "pHasAddr"}]}]}]},
    "HS": {"each": [{"all": "stock.quant"}, {"def": "whOfQ"}]}
  }
}
