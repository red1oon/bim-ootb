{
  "template": "odoo-17",
  "version": 1,
  "source": "Odoo 17 (XML-RPC), through the Odoo agent's odoo_export.json",
  "description": "The open balances at the cut-over (bim-compiler prompts/MIGRATE_INSTALL_TENANT.md §E3C-SPEC, W-MIGRATE-ENGINE ODOO-OPEN-*): the trial balance as ONE opening GL journal, with the receivable / payable / bank accounts routed to clearing accounts, and every open customer / vendor invoice and credit note as ONE-line documents on an Opening Charge whose account is that clearing account. The 17 master sheets still come from the agent's workbook; they join this template in the next step, and the bridge set partner_keys then goes away. Field names: Odoo 17 account.move.line / account.move, checked by the agent with fields_get before anything is read.",
  "connector": { "kind": "export-json", "format": "odoo-export-json-v1", "reportAs": "odoo_sets",
    "notThisFile": "This is not a file the Odoo agent wrote (odoo_export.json, format odoo-export-json-v1). Run the current export.js again: it writes it beside the workbook." },
  "srcKey": "odoo",
  "variables": { "AR_CLEARING": "AR-CLEAR", "AP_CLEARING": "AP-CLEAR", "BANK_CLEARING": "BANK-CLEAR",
    "CHARGE_AR": "Opening Charge AR", "CHARGE_AP": "Opening Charge AP", "TAX_NONE": "OPEN-0" },
  "valueMaps": {
    "acctClass": { "asset_receivable": "AR", "liability_payable": "AP", "asset_cash": "BANK" },
    "docType": { "out_invoice": "AR Invoice", "out_refund": "AR Credit Memo", "in_invoice": "AP Invoice", "in_refund": "AP CreditMemo" },
    "isSO": { "out_invoice": "Y", "out_refund": "Y", "in_invoice": "N", "in_refund": "N" },
    "sign": { "out_invoice": 1, "out_refund": -1, "in_invoice": -1, "in_refund": 1 }
  },
  "defs": {
    "bal": { "round": ["$balance", "@manifest.currency_places"] },
    "class": { "str": { "map": ["acctClass", { "find": ["account.account", "id", "$account_id", "account_type"] }] } },
    "clearing": { "if": [{ "eq": [{ "def": "class" }, "AR"] }, "${AR_CLEARING}",
                  { "if": [{ "eq": [{ "def": "class" }, "AP"] }, "${AP_CLEARING}",
                  { "if": [{ "eq": [{ "def": "class" }, "BANK"] }, "${BANK_CLEARING}", ""] }] }] },
    "isInvoice": { "in": [{ "str": "$move_type" }, ["out_invoice", "out_refund", "in_invoice", "in_refund"]] },
    "foreign": { "ne": [{ "str": "$currency_id" }, { "str": "$company_currency_id" }] },
    "held": { "str": { "find": ["partner_keys", "id", "$partner_id", "held"] } },
    "bpValue": { "str": { "find": ["partner_keys", "id", "$partner_id", "value"] } },
    "notBroughtIn": { "or": [{ "not": { "def": "isInvoice" } }, { "def": "foreign" }, { "def": "held" }, { "not": { "def": "bpValue" } }, { "gt": [{ "len": { "str": "$move_name" } }, 30] }] }
  },
  "entities": {
    "I_GLJournal": { "from": "tb",
      "where": { "ne": [{ "def": "bal" }, 0] },
      "fields": {
        "BatchDocumentNo": { "concat": ["OPEN-TB-", "@manifest.cutover"] },
        "BatchDescription": { "cut": [{ "concat": ["Opening balances from Odoo ", "@manifest.db", " at ", "@manifest.cutover"] }, 255] },
        "JournalDocumentNo": { "concat": ["OPEN-TB-", "@manifest.cutover"] },
        "DocTypeName": "GL Journal", "CategoryName": "Manual", "PostingType": "A",
        "DateAcct": "@manifest.cutover", "ISO_Code": "@manifest.currency",
        "AccountValue": { "first": [{ "def": "clearing" }, { "find": ["account.account", "id", "$account_id", "code"] }] },
        "AmtSourceDr": { "if": [{ "gt": [{ "def": "bal" }, 0] }, { "def": "bal" }, 0] },
        "AmtSourceCr": { "if": [{ "lt": [{ "def": "bal" }, 0] }, { "abs": { "def": "bal" } }, 0] },
        "Description": { "cut": [{ "concat": ["Opening balance of ", "$account_id__name"] }, 255] },
        "I_IsImported": "N" },
      "prov": { "odoo": "account.move.line (read_group by account)", "account": "$account_id", "lines": "$__count" } },
    "I_Invoice": { "from": "open_lines",
      "refuse": [
        { "when": { "not": { "def": "isInvoice" } }, "why": "an open receivable / payable line of a journal entry that is not an invoice (an unallocated payment or a manual entry): not brought in yet — its amount stays on the clearing account" },
        { "when": { "def": "foreign" }, "why": "an open item in a foreign currency: not brought in yet — its amount stays on the clearing account" },
        { "when": { "def": "held" }, "why": "the open item's partner is your own company or an internal user (held, not a business partner)" },
        { "when": { "not": { "def": "bpValue" } }, "why": "the open item's partner has no business partner in the workbook" },
        { "when": { "gt": [{ "len": { "str": "$move_name" } }, 30] }, "why": "the document number is longer than 30 characters" } ],
      "group": { "by": ["$move_id"], "sum": { "PriceActual": { "of": { "mul": ["$amount_residual", { "map": ["sign", "$move_type"] }] } } } },
      "fields": {
        "DocumentNo": { "str": "$move_name" },
        "DocTypeName": { "map": ["docType", "$move_type"] },
        "IsSOTrx": { "map": ["isSO", "$move_type"] },
        "BPartnerValue": { "def": "bpValue" },
        "DateInvoiced": { "first": ["$invoice_date", "$date"] },
        "DateAcct": "@manifest.cutover", "ISO_Code": "@manifest.currency",
        "PaymentTermValue": { "cut": [{ "str": { "find": ["open_moves", "id", "$move_id", "invoice_payment_term_id__name"] } }, 40] },
        "ChargeName": { "if": [{ "eq": [{ "map": ["isSO", "$move_type"] }, "Y"] }, "${CHARGE_AR}", "${CHARGE_AP}"] },
        "QtyOrdered": 1,
        "TaxIndicator": "${TAX_NONE}",
        "Description": { "cut": [{ "concat": ["Open item from Odoo: ", "$move_name"] }, 255] },
        "I_IsImported": "N" },
      "prov": { "odoo": "account.move", "id": "$move_id", "name": "$move_name" },
      "notes": [
        { "when": { "any": ["open_lines", { "def": "notBroughtIn" }] },
          "text": { "concat": ["Open lines NOT brought in — receivable ",
            { "round": [{ "sumSet": ["open_lines", { "and": [{ "def": "notBroughtIn" }, { "eq": [{ "def": "class" }, "AR"] }] }, "$amount_residual"] }, "@manifest.currency_places"] },
            ", payable ",
            { "round": [{ "sumSet": ["open_lines", { "and": [{ "def": "notBroughtIn" }, { "eq": [{ "def": "class" }, "AP"] }] }, "$amount_residual"] }, "@manifest.currency_places"] },
            " ", "@manifest.currency", " (debit +, credit −). Those amounts stay on the AR / AP clearing accounts until the lines are entered by hand."] } } ] }
  },
  "manifest": { "tool": "migrate/templates/odoo-17.json", "format": "ninja-open-balances-v1", "db": "@manifest.db", "cutover": "@manifest.cutover", "currency": "@manifest.currency",
    "currency_places": "@manifest.currency_places", "company_id": "@manifest.company_id", "odoo_version": "@manifest.odoo_version",
    "clearing": { "obj": { "AR": "${AR_CLEARING}", "AP": "${AP_CLEARING}", "BANK": "${BANK_CLEARING}" } },
    "charges": { "obj": { "AR": "${CHARGE_AR}", "AP": "${CHARGE_AP}" } }, "tax": "${TAX_NONE}",
    "left": { "obj": {
      "AR": { "round": [{ "sumSet": ["open_lines", { "and": [{ "def": "notBroughtIn" }, { "eq": [{ "def": "class" }, "AR"] }] }, "$amount_residual"] }, "@manifest.currency_places"] },
      "AP": { "round": [{ "sumSet": ["open_lines", { "and": [{ "def": "notBroughtIn" }, { "eq": [{ "def": "class" }, "AP"] }] }, "$amount_residual"] }, "@manifest.currency_places"] } } } }
}
