{
  "template": "bc-w1",
  "version": 1,
  "source": "Dynamics 365 Business Central (W1), configuration package exported to Excel",
  "description": "erp/plugins/bc_migrate_convert.mjs re-expressed as data (bim-compiler prompts/MIGRATE_INSTALL_TENANT.md §ENGINE-D-SPEC, W-MIGRATE-ENGINE). Sets are BC table ids; field names come from Microsoft's published model (plugins/bc_model.mjs, microsoft/BCApps). Legacy rule citations are carried in each patch's 'rule'.",
  "connector": { "kind": "bc-package", "reportAs": "bc_tables" },
  "srcKey": "bc",
  "variables": { "CUTOVER": "" },
  "valueMaps": { "accountCategory": { "Assets": "A", "Liabilities": "L", "Equity": "O", "Income": "R", "CostofGoodsSold": "E", "Expense": "E" } },
  "let": {
    "GLS": { "row": ["98", 0] },
    "LCY": { "or": ["%GLS.LCY Code", ""] },
    "CO": { "row": ["79", 0] },
    "COC": { "if": ["%CO", { "or": ["%CO.Country/Region Code", ""] }, ""] },
    "ONE": { "obj": {} },
    "NOLOC": { "if": [{ "any": ["32", { "not": "$Location Code" }] }, { "obj": { "Code": "BC-NOLOC", "Name": "Business Central: no location", "_blank": true } }, null] }
  },
  "defs": {
    "addr": { "or": ["$Address", "$Address 2", "$City", "$Post Code", "$Country/Region Code"] },
    "coAddr": { "and": ["%CO", { "with": ["%CO", { "def": "addr" }] }] },
    "dueF": { "replace": [{ "or": ["$Due Date Calculation", ""] }, "[<>]", "g", ""] },
    "dueDays": { "re": ["^(\\d+)D$", "i", { "def": "dueF" }, 1] },
    "complexTerm": { "and": [{ "def": "dueF" }, { "not": { "def": "dueDays" } }] },
    "glCat": { "replace": [{ "or": [{ "enum": ["15", "Account Category", "$Account Category"] }, ""] }, "[^A-Za-z]", "g", ""] },
    "glType": { "enum": ["15", "Account Type", "$Account Type"] },
    "bpBlocked": { "enum": ["#tag", "Blocked", "$Blocked"] },
    "itemType": { "enum": ["27", "Type", "$Type"] },
    "vendorBP": { "lookup": ["C_BPartner", { "concat": ["#tag", "/", "$No."] }, { "concat": ["23/", "$Vendor No."] }, "!Value"] },
    "lc": { "or": ["$Location Code", ""] },
    "whCode": { "first": ["$Location Code", "BC-NOLOC"] },
    "docNo": { "cut": [{ "concat": ["OPEN-", { "def": "whCode" }, "-", "${CUTOVER}"] }, 30] },
    "postDate": { "cut": [{ "str": "$Posting Date" }, 10] },
    "locRow": { "if": [{ "def": "addr" }, "$", "%CO"] },
    "locFields": { "obj": {} }
  },
  "entities": {
    "C_UOM": { "from": "204",
      "fields": { "Name": "$Code", "UOMSymbol": "$Code", "StdPrecision": "", "X12DE355": { "or": ["$International Standard Code", ""] } },
      "prov": { "bc": 204, "key": "$Code", "description": "$Description" },
      "problems": [
        { "when": { "not": { "hasSet": "98" } }, "text": "Add the table General Ledger Setup (98) to the package: its LCY Code is the currency of the sale prices (not guessed)." },
        { "when": { "and": [{ "hasSet": "98" }, { "not": "%LCY" }] }, "text": "General Ledger Setup (98) in the package has no LCY Code." }] },
    "C_PaymentTerm": { "from": "3",
      "fields": { "Value": "$Code", "Name": { "or": ["$Description", "$Code"] }, "NetDays": { "if": [{ "def": "dueDays" }, { "def": "dueDays" }, ""] } },
      "prov": { "bc": 3, "key": "$Code", "due": { "def": "dueF" } },
      "notes": [{ "when": { "countWhere": ["C_PaymentTerm", { "def": "complexTerm" }] },
        "text": { "concat": [{ "countWhere": ["C_PaymentTerm", { "def": "complexTerm" }] }, " payment term(s) have a due-date formula the ERP terms do not carry as days (",
          { "join": [{ "collect": ["C_PaymentTerm", { "def": "complexTerm" }, { "concat": ["$Code", "=", { "def": "dueF" }] }] }, ", "] }, "): imported as the term, the formula kept in the manifest."] } }] },
    "M_Product_Category": { "from": "5722", "sort": { "treeDepth": ["5722", "Code", "Parent Category", 20] },
      "fields": { "Value": "$Code", "Name": { "or": ["$Description", "$Code"] }, "M_Product_Category_Parent_ID>Value": { "or": ["$Parent Category", ""] } },
      "prov": { "bc": 5722, "key": "$Code" } },
    "C_ElementValue": { "from": "15",
      "fields": { "Value": "$No.", "Name": "$Name", "AccountType": { "or": [{ "map": ["accountCategory", { "def": "glCat" }] }, ""] }, "AccountSign": "N",
                  "IsSummary": { "if": [{ "and": [{ "def": "glType" }, { "ne": [{ "def": "glType" }, "Posting"] }] }, "Y", "N"] }, "C_Element_ID>ElementType": "A" },
      "prov": { "bc": 15, "key": "$No.", "category": "$Account Category", "type": "$Account Type" },
      "patches": [{ "column": "C_Element_ID", "cell": "C_Element_ID>ElementType = A", "rule": "ImportAccount.java:130-143 — the account element of the tenant", "rows": { "count": "C_ElementValue" } }],
      "notes": [{ "when": { "countWhere": ["C_ElementValue", { "not": { "map": ["accountCategory", { "def": "glCat" }] } }] },
        "text": { "concat": [{ "countWhere": ["C_ElementValue", { "not": { "map": ["accountCategory", { "def": "glCat" }] } }] }, " G/L account(s) have no Account Category in BC (",
          { "join": [{ "take": [{ "collect": ["C_ElementValue", { "not": { "map": ["accountCategory", { "def": "glCat" }] } }, "$No."] }, 8] }, ", "] },
          { "if": [{ "gt": [{ "countWhere": ["C_ElementValue", { "not": { "map": ["accountCategory", { "def": "glCat" }] } }] }, 8] }, " …", ""] }, "): AccountType left to the ERP default."] } }] },
    "C_BPartner": [
      { "from": "18", "tag": 18,
        "fields": { "Value": { "str": "$No." }, "Name": "$Name", "TaxID": { "or": ["$VAT Registration No.", ""] }, "IsCustomer": "Y", "IsVendor": "N", "C_BP_Group_ID>IsDefault": "Y",
                    "IsActive": { "if": [{ "eq": [{ "def": "bpBlocked" }, "All"] }, "N", "Y"] } },
        "rename": { "col": "Value", "label": { "caption": "#tag" }, "to": { "concat": ["#v", " (", "#label", ")"] }, "src": { "concat": ["#label", " ", "#v"] }, "why": { "concat": ["the same No. is a ", "#prev", " too"] } },
        "prov": { "bc": "#tag", "key": "$No." } },
      { "from": "23", "tag": 23,
        "fields": { "Value": { "str": "$No." }, "Name": "$Name", "TaxID": { "or": ["$VAT Registration No.", ""] }, "IsCustomer": "N", "IsVendor": "Y", "C_BP_Group_ID>IsDefault": "Y",
                    "IsActive": { "if": [{ "eq": [{ "def": "bpBlocked" }, "All"] }, "N", "Y"] } },
        "rename": { "col": "Value", "label": { "caption": "#tag" }, "to": { "concat": ["#v", " (", "#label", ")"] }, "src": { "concat": ["#label", " ", "#v"] }, "why": { "concat": ["the same No. is a ", "#prev", " too"] } },
        "prov": { "bc": "#tag", "key": "$No." },
        "patches": [{ "column": "C_BP_Group_ID", "cell": "C_BP_Group_ID>IsDefault = Y", "rule": "ImportBPartner.java:129-132 — the client's default business partner group", "rows": { "count": "C_BPartner" } }],
        "notes": [{ "when": { "countWhere": ["C_BPartner", { "and": [{ "def": "bpBlocked" }, { "ne": [{ "def": "bpBlocked" }, " "] }, { "ne": [{ "def": "bpBlocked" }, "All"] }] }] },
          "text": { "concat": [{ "countWhere": ["C_BPartner", { "and": [{ "def": "bpBlocked" }, { "ne": [{ "def": "bpBlocked" }, " "] }, { "ne": [{ "def": "bpBlocked" }, "All"] }] }] }, " partner(s) are partly blocked in BC (",
            { "join": [{ "take": [{ "collect": ["C_BPartner", { "and": [{ "def": "bpBlocked" }, { "ne": [{ "def": "bpBlocked" }, " "] }, { "ne": [{ "def": "bpBlocked" }, "All"] }] },
              { "concat": [{ "caption": "#tag" }, " ", "$No.", " blocked \"", "$Blocked", "\""] }] }, 5] }, "; "] }, "): imported active; only Blocked = All becomes inactive."] } }] }
    ],
    "C_BPartner_Location": [
      { "from": { "of": "C_BPartner" }, "where": { "def": "addr" },
        "fields": { "C_BPartner_ID>Value": "&Value", "C_Location_ID>C_Location_UU": { "uuid5": { "concat": ["bc/", "#tag", "/", "$No."] } }, "Name": "" },
        "prov": { "bc": "#tag", "key": "$No.", "part": "address" } },
      { "from": "222", "tag": 222,
        "refuse": [{ "when": { "not": { "lookup": ["C_BPartner", { "concat": ["#tag", "/", "$No."] }, { "concat": ["18/", "$Customer No."] }, "!Value"] } }, "why": "ship-to address of a customer not in the package" }],
        "fields": { "C_BPartner_ID>Value": { "lookup": ["C_BPartner", { "concat": ["#tag", "/", "$No."] }, { "concat": ["18/", "$Customer No."] }, "!Value"] },
                    "C_Location_ID>C_Location_UU": { "uuid5": { "concat": ["bc/222/", "$Customer No.", "/", "$Code"] } }, "Name": { "or": ["$Name", "$Code"] } },
        "prov": { "bc": 222, "key": { "concat": ["$Customer No.", "/", "$Code"] } } }
    ],
    "AD_User": { "from": { "of": "C_BPartner" }, "where": { "or": ["$Contact", "$E-Mail", "$Phone No."] },
      "fields": { "Name": { "or": ["$Contact", "$Name"] }, "EMail": { "or": ["$E-Mail", ""] }, "Phone": { "or": ["$Phone No.", ""] }, "Phone2": { "or": ["$Mobile Phone No.", ""] },
                  "C_BPartner_ID>Value": "&Value", "IsActive": "Y" },
      "prov": { "bc": "#tag", "key": "$No.", "part": "contact" } },
    "M_Product": { "from": "27",
      "fields": { "Value": "$No.", "Name": { "or": ["$Description", "$No."] }, "Description": { "or": ["$Description 2", ""] }, "M_Product_Category_ID>Value": { "or": ["$Item Category Code", ""] },
                  "M_Product_Category_ID>IsDefault": { "if": ["$Item Category Code", "", "Y"] }, "C_UOM_ID": { "or": ["$Base Unit of Measure", ""] },
                  "ProductType": { "if": [{ "eq": [{ "def": "itemType" }, "Service"] }, "S", "I"] }, "UPC": { "or": ["$GTIN", ""] }, "Weight": { "or": ["$Net Weight", ""] },
                  "Volume": { "or": ["$Unit Volume", ""] }, "C_TaxCategory_ID>IsDefault": "Y",
                  "IsActive": { "if": [{ "re": ["^(true|yes|1|ja|oui|sí|si)$", "i", { "trim": { "or": ["$Blocked", ""] } }, 0] }, "N", "Y"] } },
      "prov": { "bc": 27, "key": "$No.", "type": "$Type" },
      "patches": [
        { "column": "C_TaxCategory_ID", "cell": "C_TaxCategory_ID>IsDefault = Y", "rule": "ImportProduct.java:415 — the client's default tax category", "rows": { "count": "M_Product" } },
        { "column": "M_Product_Category_ID", "cell": "M_Product_Category_ID>IsDefault = Y", "rule": "ImportProduct.java:213-221 — the client's default product category for an item BC keeps without one", "rows": { "countWhere": ["M_Product", { "not": "$Item Category Code" }] } }],
      "notes": [{ "when": { "countWhere": ["M_Product", { "eq": [{ "def": "itemType" }, "Non-Inventory"] }] },
        "text": { "concat": [{ "countWhere": ["M_Product", { "eq": [{ "def": "itemType" }, "Non-Inventory"] }] }, " item(s) are Non-Inventory in BC: imported as items (ProductType I); stock is not kept for them in BC."] } }] },
    "M_Product_PO": [
      { "from": "99", "once": { "concat": ["$Item No.", "|", "$Vendor No."] },
        "refuse": [{ "when": { "or": [{ "not": { "def": "vendorBP" } }, { "not": { "lookup": ["M_Product", "$No.", "$Item No.", "!Value"] } }] }, "why": "a vendor or item not in the package" }],
        "fields": { "M_Product_ID>Value": "$Item No.", "C_BPartner_ID>Value": { "def": "vendorBP" }, "PricePO": { "lookup": ["M_Product", "$No.", "$Item No.", { "or": ["$Last Direct Cost", ""] }] },
                    "VendorProductNo": { "or": ["$Vendor Item No.", "$Item No."] }, "Order_Min": "", "DeliveryTime_Promised": "" },
        "prov": { "bc": 99, "key": { "concat": ["$Item No.", "/", "$Vendor No."] } } },
      { "from": { "of": "M_Product" }, "where": "$Vendor No.", "once": { "concat": ["$No.", "|", "$Vendor No."] },
        "refuse": [{ "when": { "or": [{ "not": { "def": "vendorBP" } }, { "not": { "lookup": ["M_Product", "$No.", "$No.", "!Value"] } }] }, "why": "a vendor or item not in the package" }],
        "fields": { "M_Product_ID>Value": "$No.", "C_BPartner_ID>Value": { "def": "vendorBP" }, "PricePO": { "lookup": ["M_Product", "$No.", "$No.", { "or": ["$Last Direct Cost", ""] }] },
                    "VendorProductNo": { "or": ["$Vendor Item No.", "$No."] }, "Order_Min": "", "DeliveryTime_Promised": "" },
        "prov": { "bc": 27, "key": "$No.", "field": "Vendor No." },
        "patches": [
          { "column": "PricePO", "cell": "the item's Last Direct Cost", "rule": "BC keeps purchase prices in Price List Lines (not read in this alpha); Last Direct Cost is the item card's last purchase price", "rows": { "count": "M_Product_PO" } },
          { "column": "VendorProductNo", "cell": "the item's No.", "rule": "ImportProduct.java:393-394 — VendorProductNo=Value when the vendor gave none", "rows": { "countWhere": ["M_Product_PO", { "not": "$Vendor Item No." }] } }] }
    ],
    "M_PriceList": { "from": { "let": "ONE" }, "where": { "and": ["%LCY", { "size": "27" }] },
      "fields": { "Name": "BC Unit Price", "IsSOPriceList": "Y", "C_Currency_ID>ISO_Code": "%LCY" },
      "prov": { "bc": 98, "field": "LCY Code" },
      "patches": [{ "when": { "count": "M_PriceList" }, "column": "Name", "cell": "BC Unit Price", "rule": "BC keeps the sale price on the item card (Unit Price): one list named after that field", "rows": 1 }] },
    "M_PriceList_Version": { "from": { "let": "ONE" }, "where": { "count": "M_PriceList" },
      "fields": { "M_PriceList_ID": "BC Unit Price", "Name": "${CUTOVER}", "ValidFrom": "${CUTOVER}", "M_DiscountSchema_ID>DiscountType": "P" },
      "prov": { "cutover": "${CUTOVER}" },
      "patches": [{ "when": { "count": "M_PriceList_Version" }, "column": "M_DiscountSchema_ID", "cell": "M_DiscountSchema_ID>DiscountType = P", "rule": "ImportPriceList.java:97-98 — the first price-list schema of the client", "rows": 1 }] },
    "M_ProductPrice": { "from": "27", "where": { "count": "M_PriceList" },
      "fields": { "M_PriceList_Version_ID": "${CUTOVER}", "M_Product_ID>Value": "$No.", "PriceList": { "or": ["$Unit Price", "0"] }, "PriceStd": { "or": ["$Unit Price", "0"] } },
      "prov": { "bc": 27, "key": "$No.", "field": "Unit Price" } },
    "M_Warehouse": [
      { "from": "14",
        "fields": { "Value": "$Code", "Name": { "or": ["$Name", "$Code"] },
                    "C_Location_ID>C_Location_UU": { "if": [{ "def": "addr" }, { "uuid5": { "concat": ["bc/14/", "$Code"] } }, { "if": [{ "def": "coAddr" }, { "uuid5": "bc/79/company" }, ""] }] } },
        "prov": { "bc": 14, "key": "$Code" } },
      { "from": { "let": "NOLOC" }, "tag": "blank",
        "fields": { "Value": "$Code", "Name": { "or": ["$Name", "$Code"] },
                    "C_Location_ID>C_Location_UU": { "if": [{ "def": "addr" }, { "uuid5": { "concat": ["bc/14/", "$Code"] } }, { "if": [{ "def": "coAddr" }, { "uuid5": "bc/79/company" }, ""] }] } },
        "prov": { "bc": "blank location", "key": "$Code" },
        "patches": [
          { "when": "%NOLOC", "column": "Value", "cell": "BC-NOLOC", "rule": "BC keeps stock without a location (blank Location Code); the ERP keeps stock in a warehouse — one named for it", "rows": 1 },
          { "column": "C_Location_ID", "cell": { "if": ["%CO", "the Company Information address", "(none)"] },
            "rule": { "concat": ["M_Warehouse.C_Location_ID is mandatory; these BC locations have no address: ",
              { "join": [{ "collect": ["M_Warehouse", { "not": { "def": "addr" } }, { "if": [{ "def": "coAddr" }, "$Code", { "concat": ["$Code", " (no company address either)"] }] }] }, ", "] }] },
            "rows": { "countWhere": ["M_Warehouse", { "not": { "def": "addr" } }] } }] }
    ],
    "M_Locator": [
      { "from": { "of": "M_Warehouse" },
        "fields": { "M_Warehouse_ID>Value": "$Code", "Value": "$Code", "X": "0", "Y": "0", "Z": { "seq": "Z" }, "IsActive": "Y" },
        "prov": { "bc": { "if": [{ "eq": ["#tag", "blank"] }, "blank location", 14] }, "key": "$Code", "part": "location locator" } },
      { "from": "7354",
        "refuse": [{ "when": { "not": { "exists": ["M_Warehouse", "Value", "$Location Code"] } }, "why": "a bin whose location is not in the package" }],
        "fields": { "M_Warehouse_ID>Value": "$Location Code", "Value": { "concat": ["$Location Code", "/", "$Code"] }, "X": "0", "Y": "0", "Z": { "seq": "Z" }, "IsActive": "Y" },
        "prov": { "bc": 7354, "key": { "concat": ["$Location Code", "/", "$Code"] } },
        "patches": [{ "column": "Z", "cell": "a running number", "rule": "legacy unique index m_location_where (M_Warehouse_ID, X, Y, Z); BC bins carry no X/Y/Z", "rows": { "count": "M_Locator" } }] }
    ],
    "M_InventoryLine": { "from": "32",
      "refuse": [{ "when": { "not": { "def": "postDate" } }, "why": "item ledger entries without a Posting Date" },
                 { "when": { "and": ["${CUTOVER}", { "gt": [{ "def": "postDate" }, "${CUTOVER}"] }] }, "silent": "LATER" }],
      "group": { "by": [{ "def": "lc" }, { "str": "$Item No." }], "sort": true, "sum": { "QtyCount": { "of": { "num": { "or": ["$Quantity", 0] } }, "places": 6 } }, "having": "QtyCount" },
      "fields": { "M_Inventory_ID": { "def": "docNo" }, "M_Locator_ID>Value": { "def": "whCode" }, "M_Product_ID>Value": { "str": "$Item No." } },
      "prov": { "bc": 32, "key": { "concat": [{ "def": "lc" }, "|", "$Item No."] } },
      "notes": [{ "when": { "counter": "LATER" }, "text": { "concat": [{ "counter": "LATER" }, " item ledger entr(y/ies) are after the cutover ", "${CUTOVER}", ": not in the opening stock."] } }] },
    "M_Inventory": { "from": { "of": "M_InventoryLine" },
      "group": { "by": [{ "def": "lc" }], "sort": true },
      "fields": { "DocumentNo": { "def": "docNo" }, "M_Warehouse_ID>Value": { "def": "whCode" }, "MovementDate": "${CUTOVER}", "C_DocType_ID>DocSubTypeInv": "PI",
                  "Description": { "concat": ["Opening stock from Business Central at ", "${CUTOVER}"] } },
      "prov": { "bc": 32, "key": { "def": "lc" } },
      "patches": [
        { "column": "C_DocType_ID", "cell": "C_DocType_ID>DocSubTypeInv = PI", "rule": "MSetup.java:776 — the one Physical Inventory document type", "rows": { "count": "M_Inventory" } },
        { "column": "DocumentNo", "cell": "OPEN-<location>-<cutover>", "rule": "the lines find their header by DocumentNo (Ninja MigrateExcelData Line rule)", "rows": { "count": "M_Inventory" } }] },
    "C_Location": [
      { "from": { "of": "C_BPartner" }, "where": { "def": "addr" }, "unique": "C_Location_UU",
        "fields": { "Address1": { "or": ["$Address", ""] }, "Address2": { "or": ["$Address 2", ""] }, "City": { "or": ["$City", ""] }, "Postal": { "or": ["$Post Code", ""] }, "RegionName": { "or": ["$County", ""] },
                    "C_Country_ID>CountryCode": { "first": ["$Country/Region Code", "%COC"] }, "C_Location_UU": { "uuid5": { "concat": ["bc/", "#tag", "/", "$No."] } }, "_noCountry": { "if": ["$Country/Region Code", "", "Y"] } },
        "prov": { "bc": { "concat": ["#tag", "/", "$No."] } } },
      { "from": { "of": "C_BPartner_Location" }, "where": { "eq": ["#tag", 222] }, "unique": "C_Location_UU",
        "fields": { "Address1": { "or": ["$Address", ""] }, "Address2": { "or": ["$Address 2", ""] }, "City": { "or": ["$City", ""] }, "Postal": { "or": ["$Post Code", ""] }, "RegionName": { "or": ["$County", ""] },
                    "C_Country_ID>CountryCode": { "first": ["$Country/Region Code", "%COC"] }, "C_Location_UU": { "uuid5": { "concat": ["bc/222/", "$Customer No.", "/", "$Code"] } }, "_noCountry": { "if": ["$Country/Region Code", "", "Y"] } },
        "prov": { "bc": { "concat": ["222/", "$Customer No.", "/", "$Code"] } } },
      { "from": { "of": "M_Warehouse" }, "where": { "or": [{ "def": "addr" }, { "def": "coAddr" }] }, "unique": "C_Location_UU",
        "fields": { "Address1": { "with": [{ "def": "locRow" }, { "or": ["$Address", ""] }] }, "Address2": { "with": [{ "def": "locRow" }, { "or": ["$Address 2", ""] }] },
                    "City": { "with": [{ "def": "locRow" }, { "or": ["$City", ""] }] }, "Postal": { "with": [{ "def": "locRow" }, { "or": ["$Post Code", ""] }] },
                    "RegionName": { "with": [{ "def": "locRow" }, { "or": ["$County", ""] }] }, "C_Country_ID>CountryCode": { "with": [{ "def": "locRow" }, { "first": ["$Country/Region Code", "%COC"] }] },
                    "C_Location_UU": { "if": [{ "def": "addr" }, { "uuid5": { "concat": ["bc/14/", "$Code"] } }, { "uuid5": "bc/79/company" }] },
                    "_noCountry": { "with": [{ "def": "locRow" }, { "if": ["$Country/Region Code", "", "Y"] }] } },
        "prov": { "bc": { "if": [{ "def": "addr" }, { "concat": ["14/", "$Code"] }, "79/company"] } },
        "patches": [
          { "column": "C_Country_ID", "cell": { "if": ["%COC", { "concat": ["Company Information's country (", "%COC", ")"] }, "(none: add Company Information (79))"] },
            "rule": "C_Location.C_Country_ID is mandatory; BC leaves the country blank for a domestic address", "rows": { "countWhere": ["C_Location", "!_noCountry"] } },
          { "column": "C_Location_UU", "cell": "UUID v5 of \"bc/<table>/<key>\"", "rule": "iDempiere's record key for moving data between systems: the address is found by it, not by its street", "rows": { "count": "C_Location" } }] }
    ]
  },
  "manifest": {
    "tool": "erp/migrate/engine.mjs + erp/migrate/templates/bc-w1.json", "format": "ninja-workbook-v3", "source": "Dynamics 365 Business Central configuration package", "alpha": true,
    "workbook": "bc_migration.xlsx", "package": "@code", "cutover": "${CUTOVER}", "currency": "%LCY", "model": { "obj": { "source": "@model.source", "commit": "@model.commit" } },
    "unknown_headers": "@unknown", "skipped_sheets": "@skipped"
  }
}
