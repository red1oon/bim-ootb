{
  "template": "sap-b1-10",
  "version": 1,
  "source": "SAP Business One 10 (Service Layer), through the SAP agent's sap_export.json",
  "description": "erp/plugins/sap_migrate_convert.mjs re-expressed as data (bim-compiler prompts/MIGRATE_INSTALL_TENANT.md §ENGINE-D-SPEC, W-MIGRATE-ENGINE). Field names: SAP's guide 'Working with SAP Business One Service Layer' v1.26 + the user's own $metadata (the agent lists what the server lacks). Legacy rule citations are carried in each patch's 'rule'.",
  "connector": { "kind": "export-json", "format": "sap-b1-export-v1", "reportAs": "sap_sets",
    "notThisFile": "This is not a file the SAP Business One agent wrote (sap_export.json, format sap-b1-export-v1)." },
  "srcKey": "sap",
  "variables": { "CUTOVER": "", "PRICE_LIST": null },
  "valueMaps": { "accountType": { "at_Revenues": "R", "at_Expenses": "E" } },
  "let": {
    "YES": ["tYES", "Y", 1, "1"],
    "PL": { "pick": { "from": "PriceLists", "sortBy": { "num": "$PriceListNo" }, "prefer": { "eq": [{ "str": "$PriceListNo" }, { "str": "${PRICE_LIST}" }] } } },
    "CUR": { "if": ["%PL", { "first": ["%PL.DefaultPrimeCurrency", "@admin.LocalCurrency"] }, ""] },
    "PLN": { "if": ["%PL", { "first": ["%PL.PriceListName", { "concat": ["Price list ", "%PL.PriceListNo"] }] }, ""] }
  },
  "defs": {
    "plainTerm": { "and": [{ "not": { "num": { "or": ["$NumberOfAdditionalMonths", 0] } } }, { "or": [{ "not": { "str": "$StartFrom" } }, { "eq": [{ "str": "$StartFrom" }, "pdt_None"] }] }] },
    "inactive": { "or": [{ "in": ["$Frozen", "%YES"] }, { "and": [{ "has": "$Valid" }, { "not": { "in": ["$Valid", "%YES"] } }] }] },
    "itemType": { "str": "$ItemType" },
    "isService": { "in": [{ "str": "$ItemType" }, ["itLabor", "itTravel"]] },
    "whOk": { "first": ["$Country", "@admin.Country"] },
    "addrUU": { "uuid5": { "concat": ["sap/bp/", "^CardCode", "/", "$AddressType", "/", "$AddressName"] } },
    "hasAddr": { "or": ["$Street", "$Block", "$City", "$ZipCode", "$Country"] },
    "plGate": { "and": ["%PL", "%CUR", { "count": "M_Product" }] }
  },
  "entities": {
    "C_UOM": { "from": "UnitOfMeasurements",
      "fields": { "Name": { "str": "$Code" }, "UOMSymbol": { "str": "$Code" }, "StdPrecision": "", "X12DE355": { "str": "$InternationalSymbol" } },
      "prov": { "sap": "UnitOfMeasurements", "key": "$AbsEntry" } },
    "C_PaymentTerm": { "from": "PaymentTermsTypes",
      "fields": { "Value": { "str": "$GroupNumber" }, "Name": { "first": ["$PaymentTermsGroupName", "$GroupNumber"] },
                  "NetDays": { "if": [{ "and": [{ "def": "plainTerm" }, { "has": "$NumberOfAdditionalDays" }] }, { "str": "$NumberOfAdditionalDays" }, ""] } },
      "prov": { "sap": "PaymentTermsTypes", "key": "$GroupNumber" },
      "notes": [{ "when": { "countWhere": ["C_PaymentTerm", { "not": { "def": "plainTerm" } }] },
                  "text": { "concat": [{ "countWhere": ["C_PaymentTerm", { "not": { "def": "plainTerm" } }] }, " payment term(s) count months or start at a month end/half (",
                    { "join": [{ "collect": ["C_PaymentTerm", { "not": { "def": "plainTerm" } }, { "str": "$GroupNumber" }] }, ", "] }, "): imported as the term without days."] } }] },
    "M_Product_Category": { "from": "ItemGroups",
      "fields": { "Value": { "str": "$Number" }, "Name": { "first": ["$GroupName", "$Number"] }, "M_Product_Category_Parent_ID>Value": "" },
      "prov": { "sap": "ItemGroups", "key": "$Number" } },
    "C_ElementValue": { "from": "ChartOfAccounts",
      "fields": { "Value": { "str": "$Code" }, "Name": { "first": ["$Name", "$Code"] }, "AccountType": { "or": [{ "map": ["accountType", "$AccountType"] }, ""] }, "AccountSign": "N",
                  "IsSummary": { "if": [{ "and": [{ "has": "$ActiveAccount" }, { "not": { "in": ["$ActiveAccount", "%YES"] } }] }, "Y", "N"] }, "C_Element_ID>ElementType": "A" },
      "prov": { "sap": "ChartOfAccounts", "key": "$Code", "type": "$AccountType" },
      "patches": [{ "column": "C_Element_ID", "cell": "C_Element_ID>ElementType = A", "rule": "ImportAccount.java:130-143 — the account element of the tenant", "rows": { "count": "C_ElementValue" } }],
      "notes": [{ "when": { "countWhere": ["C_ElementValue", { "not": { "map": ["accountType", "$AccountType"] } }] },
                  "text": { "concat": [{ "countWhere": ["C_ElementValue", { "not": { "map": ["accountType", "$AccountType"] } }] }, " account(s) are balance-sheet accounts (at_Other): the Service Layer does not say asset, liability or equity — AccountType left to the ERP default. (Next: read the class from the account table.)"] } }] },
    "C_BPartner": { "from": "BusinessPartners",
      "refuse": [{ "when": { "in": [{ "str": "$CardType" }, ["cLid", "L"]] }, "why": "a lead (CardType cLid), not a customer or vendor" }],
      "fields": { "Value": { "str": "$CardCode" }, "Name": { "first": ["$CardName", "$CardCode"] }, "TaxID": { "str": "$FederalTaxID" },
                  "IsCustomer": { "if": [{ "in": [{ "str": "$CardType" }, ["cCustomer", "C"]] }, "Y", "N"] }, "IsVendor": { "if": [{ "in": [{ "str": "$CardType" }, ["cSupplier", "S"]] }, "Y", "N"] },
                  "C_BP_Group_ID>IsDefault": "Y", "IsActive": { "if": [{ "def": "inactive" }, "N", "Y"] } },
      "prov": { "sap": "BusinessPartners", "key": { "str": "$CardCode" }, "type": { "str": "$CardType" } },
      "patches": [{ "column": "C_BP_Group_ID", "cell": "C_BP_Group_ID>IsDefault = Y", "rule": "ImportBPartner.java:129-132 — the client's default business partner group", "rows": { "count": "C_BPartner" } }] },
    "C_BPartner_Location": { "from": { "of": "C_BPartner", "each": "BPAddresses" }, "where": { "def": "hasAddr" },
      "fields": { "C_BPartner_ID>Value": { "str": "^CardCode" }, "C_Location_ID>C_Location_UU": { "def": "addrUU" }, "Name": { "str": "$AddressName" } },
      "prov": { "sap": "BPAddresses", "key": { "concat": ["^CardCode", "/", "$AddressName"] }, "type": "$AddressType" } },
    "AD_User": { "from": { "of": "C_BPartner", "each": "ContactEmployees", "match": "$Name",
        "ifNone": { "where": { "or": ["$EmailAddress", "$Phone1"] },
          "fields": { "Name": { "first": ["$ContactPerson", "$CardName", "$CardCode"] }, "EMail": { "str": "$EmailAddress" }, "Phone": { "str": "$Phone1" }, "Phone2": { "str": { "or": ["$Cellular", "$Phone2"] } },
                      "C_BPartner_ID>Value": { "str": "$CardCode" }, "IsActive": "Y" },
          "prov": { "sap": "BusinessPartners", "key": { "str": "$CardCode" }, "part": "card contact" } } },
      "fields": { "Name": { "str": "$Name" }, "EMail": { "str": "$E_Mail" }, "Phone": { "str": "$Phone1" }, "Phone2": { "str": "$MobilePhone" }, "C_BPartner_ID>Value": { "str": "^CardCode" },
                  "IsActive": { "if": [{ "and": [{ "has": "$Active" }, { "not": { "in": ["$Active", "%YES"] } }] }, "N", "Y"] } },
      "prov": { "sap": "ContactEmployees", "key": { "concat": ["^CardCode", "/", "$Name"] } } },
    "M_Product": { "from": "Items",
      "refuse": [{ "when": { "eq": [{ "def": "itemType" }, "itFixedAssets"] }, "why": "a fixed asset item (ItemType itFixedAssets): assets are not core" }],
      "fields": { "Value": { "str": "$ItemCode" }, "Name": { "first": ["$ItemName", "$ItemCode"] }, "Description": { "str": "$ForeignName" }, "M_Product_Category_ID>Value": { "str": "$ItemsGroupCode" },
                  "M_Product_Category_ID>IsDefault": { "if": [{ "has": "$ItemsGroupCode" }, "", "Y"] }, "C_UOM_ID": { "str": "$InventoryUOM" }, "C_UOM_ID>IsDefault": { "if": ["$InventoryUOM", "", "Y"] },
                  "ProductType": { "if": [{ "def": "isService" }, "S", "I"] }, "UPC": { "str": "$BarCode" }, "Weight": { "str": "$SalesUnitWeight" }, "Volume": { "str": "$SalesUnitVolume" },
                  "C_TaxCategory_ID>IsDefault": "Y", "IsActive": { "if": [{ "def": "inactive" }, "N", "Y"] } },
      "prov": { "sap": "Items", "key": "$ItemCode", "type": { "def": "itemType" } },
      "patches": [
        { "column": "C_TaxCategory_ID", "cell": "C_TaxCategory_ID>IsDefault = Y", "rule": "ImportProduct.java:415 — the client's default tax category", "rows": { "count": "M_Product" } },
        { "column": "C_UOM_ID", "cell": "C_UOM_ID>IsDefault = Y", "rule": "ImportProduct.java:304-311 — the client's default unit for an item Business One keeps without an inventory unit", "rows": { "countWhere": ["M_Product", { "not": "$InventoryUOM" }] } },
        { "column": "M_Product_Category_ID", "cell": "M_Product_Category_ID>IsDefault = Y", "rule": "ImportProduct.java:213-221 — the client's default product category for an item without an item group", "rows": { "countWhere": ["M_Product", { "not": { "has": "$ItemsGroupCode" } }] } }],
      "notes": [{ "when": { "countWhere": ["M_Product", { "and": [{ "has": "$InventoryItem" }, { "not": { "in": ["$InventoryItem", "%YES"] } }, { "not": { "def": "isService" } }] }] },
                  "text": { "concat": [{ "countWhere": ["M_Product", { "and": [{ "has": "$InventoryItem" }, { "not": { "in": ["$InventoryItem", "%YES"] } }, { "not": { "def": "isService" } }] }] }, " item(s) are not inventory items in Business One: imported as items (ProductType I)."] } }] },
    "M_Product_PO": { "from": { "of": "M_Product" }, "where": "$Mainsupplier",
      "refuse": [{ "when": { "not": { "exists": ["C_BPartner", "Value", "$Mainsupplier"] } }, "why": "a main supplier not in the export" }],
      "fields": { "M_Product_ID>Value": { "str": "$ItemCode" }, "C_BPartner_ID>Value": { "str": "$Mainsupplier" }, "PricePO": "", "VendorProductNo": { "first": ["$SupplierCatalogNo", "$ItemCode"] },
                  "Order_Min": "", "DeliveryTime_Promised": "" },
      "prov": { "sap": "Items", "key": "$ItemCode", "field": "Mainsupplier" },
      "patches": [{ "column": "VendorProductNo", "cell": "the item's code", "rule": "ImportProduct.java:393-394 — VendorProductNo=Value when the vendor gave none", "rows": { "countWhere": ["M_Product_PO", { "not": "$SupplierCatalogNo" }] } }] },
    "M_PriceList": { "from": { "let": "PL" }, "where": { "def": "plGate" },
      "fields": { "Name": "%PLN", "IsSOPriceList": "Y", "C_Currency_ID>ISO_Code": "%CUR" },
      "prov": { "sap": "PriceLists", "key": "$PriceListNo" },
      "problems": [{ "when": { "and": ["%PL", { "not": "%CUR" }] }, "text": "The price list has no currency and the company local currency was not readable: the currency is not guessed." }],
      "patches": [{ "when": { "and": [{ "count": "M_PriceList" }, { "sub": [{ "size": "PriceLists" }, 1] }, { "not": { "has": "${PRICE_LIST}" } }] }, "column": "Name", "cell": "%PLN",
                    "rule": { "concat": ["Business One keeps ", { "size": "PriceLists" }, " price lists; this alpha loads one: the lowest number (set another on the form)"] }, "rows": 1 }] },
    "M_PriceList_Version": { "from": { "let": "PL" }, "where": { "def": "plGate" },
      "fields": { "M_PriceList_ID": "%PLN", "Name": "${CUTOVER}", "ValidFrom": "${CUTOVER}", "M_DiscountSchema_ID>DiscountType": "P" },
      "prov": { "cutover": "${CUTOVER}" },
      "patches": [{ "when": { "count": "M_PriceList_Version" }, "column": "M_DiscountSchema_ID", "cell": "M_DiscountSchema_ID>DiscountType = P", "rule": "ImportPriceList.java:97-98 — the first price-list schema of the client", "rows": 1 }] },
    "M_ProductPrice": { "from": { "of": "M_Product", "each": "ItemPrices", "match": { "eq": [{ "str": "$PriceList" }, { "str": "%PL.PriceListNo" }] }, "first": true }, "where": { "def": "plGate" },
      "fields": { "M_PriceList_Version_ID": "${CUTOVER}", "M_Product_ID>Value": { "str": "^ItemCode" }, "PriceList": { "str": { "or": ["$Price", 0] } }, "PriceStd": { "str": { "or": ["$Price", 0] } } },
      "prov": { "sap": "ItemPrices", "key": { "concat": ["^ItemCode", "/", "%PL.PriceListNo"] } } },
    "M_Warehouse": { "from": "Warehouses",
      "refuse": [{ "when": { "not": { "def": "whOk" } }, "why": "a warehouse with no country, and the company country was not readable: add its country in Business One" }],
      "fields": { "Value": { "str": "$WarehouseCode" }, "Name": { "first": ["$WarehouseName", "$WarehouseCode"] }, "C_Location_ID>C_Location_UU": { "uuid5": { "concat": ["sap/wh/", "$WarehouseCode"] } } },
      "prov": { "sap": "Warehouses", "key": { "str": "$WarehouseCode" } } },
    "M_Locator": [
      { "from": { "of": "M_Warehouse" },
        "fields": { "M_Warehouse_ID>Value": { "str": "$WarehouseCode" }, "Value": { "str": "$WarehouseCode" }, "X": "0", "Y": "0", "Z": { "seq": "Z" }, "IsActive": "Y" },
        "prov": { "sap": "Warehouses", "key": { "str": "$WarehouseCode" }, "part": "warehouse locator" } },
      { "from": "BinLocations",
        "refuse": [{ "when": { "not": { "exists": ["M_Warehouse", "Value", "$Warehouse"] } }, "why": "a bin whose warehouse is not in the export" }],
        "fields": { "M_Warehouse_ID>Value": { "str": "$Warehouse" }, "Value": { "first": ["$BinCode", { "concat": ["$Warehouse", "/", "$AbsEntry"] }] }, "X": "0", "Y": "0", "Z": { "seq": "Z" },
                    "IsActive": { "if": [{ "in": ["$Inactive", "%YES"] }, "N", "Y"] } },
        "prov": { "sap": "BinLocations", "key": "$AbsEntry" },
        "patches": [{ "column": "Z", "cell": "a running number", "rule": "legacy unique index m_location_where (M_Warehouse_ID, X, Y, Z); Business One bins carry no X/Y/Z", "rows": { "count": "M_Locator" } }] }
    ],
    "M_InventoryLine": { "from": { "of": "M_Product", "each": "ItemWarehouseInfoCollection" }, "where": { "num": { "or": ["$InStock", 0] } },
      "refuse": [{ "when": { "not": { "exists": ["M_Warehouse", "Value", "$WarehouseCode"] } }, "why": "stock in a warehouse not in the export" }],
      "group": { "by": [{ "str": "$WarehouseCode" }, { "str": "^ItemCode" }], "sort": true, "sum": { "QtyCount": { "of": { "num": { "or": ["$InStock", 0] } }, "places": 6 } } },
      "fields": { "M_Inventory_ID": { "cut": [{ "concat": ["OPEN-", "$WarehouseCode", "-", "${CUTOVER}"] }, 30] }, "M_Locator_ID>Value": { "str": "$WarehouseCode" }, "M_Product_ID>Value": { "str": "^ItemCode" } },
      "prov": { "sap": "ItemWarehouseInfoCollection", "key": { "concat": ["$WarehouseCode", "|", "^ItemCode"] } } },
    "M_Inventory": { "from": { "of": "M_InventoryLine" },
      "group": { "by": [{ "str": "$WarehouseCode" }], "sort": true },
      "fields": { "DocumentNo": { "cut": [{ "concat": ["OPEN-", "$WarehouseCode", "-", "${CUTOVER}"] }, 30] }, "M_Warehouse_ID>Value": { "str": "$WarehouseCode" }, "MovementDate": "${CUTOVER}",
                  "C_DocType_ID>DocSubTypeInv": "PI", "Description": "Opening stock from SAP Business One (stock at the export)" },
      "prov": { "sap": "ItemWarehouseInfoCollection", "key": { "str": "$WarehouseCode" } },
      "patches": [
        { "column": "C_DocType_ID", "cell": "C_DocType_ID>DocSubTypeInv = PI", "rule": "MSetup.java:776 — the one Physical Inventory document type", "rows": { "count": "M_Inventory" } },
        { "column": "MovementDate", "cell": "the cut-over date", "rule": "the Service Layer item record gives the stock now (InStock), not at a date: this is the stock at the export, dated at the cut-over", "rows": { "count": "M_Inventory" } }] },
    "C_Location": [
      { "from": { "of": "C_BPartner_Location" }, "unique": "C_Location_UU",
        "fields": { "Address1": { "str": "$Street" }, "Address2": { "str": "$Block" }, "City": { "str": "$City" }, "Postal": { "str": "$ZipCode" }, "RegionName": { "str": { "or": ["$State", "$County"] } },
                    "C_Country_ID>CountryCode": { "first": ["$Country", "@admin.Country"] }, "C_Location_UU": { "def": "addrUU" } },
        "prov": { "sap": { "concat": ["bp/", "^CardCode", "/", "$AddressType", "/", "$AddressName"] } } },
      { "from": { "of": "M_Warehouse" }, "unique": "C_Location_UU",
        "fields": { "Address1": { "str": "$Street" }, "Address2": { "str": "$Block" }, "City": { "str": "$City" }, "Postal": { "str": "$ZipCode" }, "RegionName": { "str": { "or": ["$State", "$County"] } },
                    "C_Country_ID>CountryCode": { "first": ["$Country", "@admin.Country"] }, "C_Location_UU": { "uuid5": { "concat": ["sap/wh/", "$WarehouseCode"] } } },
        "prov": { "sap": { "concat": ["wh/", "$WarehouseCode"] } },
        "patches": [
          { "column": "C_Country_ID", "cell": { "if": [{ "str": "@admin.Country" }, { "concat": ["the company's country (", "@admin.Country", ")"] }, "(none: the company country was not readable)"] },
            "rule": "C_Location.C_Country_ID is mandatory; these addresses have no country", "rows": { "countWhere": ["C_Location", { "not": { "str": "$Country" } }] } },
          { "column": "C_Location_UU", "cell": "UUID v5 of \"sap/<kind>/<key>\"", "rule": "iDempiere's record key for moving data between systems: the address is found by it, not by its street", "rows": { "count": "C_Location" } }] }
    ]
  },
  "manifest": {
    "tool": "erp/migrate/engine.mjs + erp/migrate/templates/sap-b1-10.json", "format": "ninja-workbook-v3", "source": "SAP Business One Service Layer (sap_export.json)", "alpha": true,
    "workbook": "sap_b1_migration.xlsx", "company": { "if": ["@manifest.company", "present", ""] }, "version": { "str": "@manifest.version" }, "metadata": { "or": ["@manifest.metadata", null] },
    "cutover": "${CUTOVER}", "currency": "%CUR", "priceList": { "if": ["%PL", { "str": "%PL.PriceListNo" }, ""] }
  }
}
