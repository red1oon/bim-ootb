 "patches": [
  {
   "table": "C_UOM",
   "column": "X12DE355",
   "cell": "(blank)",
   "rule": "no Odoo field: the ERP \"Migrate from Odoo\" form maps each Odoo UoM to an iDempiere UoM (§B4-SPEC step 2)",
   "rows": 28
  },
  {
   "table": "C_ElementValue",
   "column": "C_Element_ID",
   "cell": "C_Element_ID>ElementType = A",
   "rule": "ImportAccount.java:130-143 — the account element of the tenant (legacy: the element the user names)",
   "rows": 47
  },
  {
   "table": "C_BPartner",
   "column": "C_BP_Group_ID",
   "cell": "C_BP_Group_ID>IsDefault = Y",
   "rule": "ImportBPartner.java:129-132 — the client's default business partner group",
   "rows": 14
  },
  {
   "table": "C_Location",
   "column": "C_Location_UU",
   "cell": "UUID v5 of \"<db>/res.partner/<id>\"",
   "rule": "iDempiere's record key for moving data between systems (2Pack resolves by the _UU column): the address is found by it, not by its street",
   "rows": 14
  },
  {
   "table": "M_Product",
   "column": "C_TaxCategory_ID",
   "cell": "C_TaxCategory_ID>IsDefault = Y",
   "rule": "ImportProduct.java:415 — the client's default tax category",
   "rows": 50
  },
  {
   "table": "M_Product_PO",
   "column": "VendorProductNo",
   "cell": "the product's Value",
   "rule": "ImportProduct.java:393-394 — VendorProductNo=Value when the vendor gave none",
   "rows": 30
  },
  {
   "table": "M_PriceList",
   "column": "Name",
   "cell": "Odoo list_price",
   "rule": "Odoo keeps the sale price on the product (list_price), not in a named list: one list named after that field",
   "rows": 1
  },
  {
   "table": "M_PriceList_Version",
   "column": "Name",
   "cell": "2026-11-09",
   "rule": "the cutover date — what the AD default @#Date@ gives a new version in the window",
   "rows": 1
  },
  {
   "table": "M_PriceList_Version",
   "column": "M_DiscountSchema_ID",
   "cell": "M_DiscountSchema_ID>DiscountType = P",
   "rule": "ImportPriceList.java:97-98 — the first price-list schema of the client",
   "rows": 1
  },
  {
   "table": "M_Locator",
   "column": "Z",
   "cell": "the Odoo stock.location id",
   "rule": "legacy unique index m_location_where (M_Warehouse_ID, X, Y, Z); Odoo repeats posx/posy/posz within the warehouse",
   "rows": 13
  },
  {
   "table": "M_Inventory",
   "column": "C_DocType_ID",
   "cell": "C_DocType_ID>DocSubTypeInv = PI",
   "rule": "MInventory.java:301-304 refuses none; MSetup.java:776 makes ONE Physical Inventory type (DocBaseType MMI, DocSubTypeInv PI) — MMI alone also matches Internal Use and Cost Adjustment",
   "rows": 1
  },
  {
   "table": "M_Inventory",
   "column": "DocumentNo",
   "cell": "OPEN-<warehouse>-<cutover>",
   "rule": "the lines find their header by DocumentNo (Ninja MigrateExcelData Line rule); legacy would number it from the sequence",
   "rows": 1
  },
  {
   "table": "C_BPartner",
   "column": "Value",
   "cell": "<code>-<odoo id> or <cut>~<odoo id>",
   "rule": "the ERP needs one Value per company (unique index) and at most 40 characters; Odoo has \"C001\" → \"C001-52\" (repeats \"C001\")",
   "rows": 1
  },
  {
   "table": "M_Product",
   "column": "Value",
   "cell": "<code>-<odoo id> or <cut>~<odoo id>",
   "rule": "the ERP needs one Value per company (unique index) and at most 510 characters; Odoo has \"DUP-1\" → \"DUP-1-55\" (repeats \"DUP-1\")",
   "rows": 1
  },
  {
   "table": "M_Locator",
   "column": "Value",
   "cell": "<code>-<odoo id> or <cut>~<odoo id>",
   "rule": "the ERP needs one Value per company (unique index) and at most 40 characters; Odoo has \"WH/Input/Order Processing/Dispatch Zone/Gate A\" → \"WH/Input/Order Processing/Dispatch Zo~21\" (longer than 40); \"WH/Input/Order Processing/Dispatch Zone/Gate B\" → \"WH/Input/Order Processing/Dispatch Zo~22\" (longer than 40)",
   "rows": 2
  }
 ],
