{
 "spec": "bim-compiler prompts/CLI_ERP_IVR.md §22.5 (the first word table) — DATA, read by common/door/words_core.js; every word expands to an EXISTING door verb, printed before it runs",
 "contexts": {
  "kind": "a kind of the building (after cd Duplex, cd Element)",
  "building": "a building (after cd Duplex)",
  "erp": "an ERP kind (after cd \"Business Partner\")",
  "any": "anywhere"
 },
 "summary": "a form marked summary shows only its summary; the next `ls` (no values) is the SAME line, served from the answer the session holds (§22.6)",
 "fill": "the context fills an input the verb has and the line did not give: building <- the building, kind <- the BIM kind (object.*) or the ERP kind (mis.* / erp.*), role <- the role, columns <- the columns the kind's list screen shows (mis_core pickColumns)",
 "choices": {
  "_": "a value a word needs and the line did not give opens a pick menu of the legal values, read by ONE door line (by the input's type); in a one-shot run or for an AI there is no menu: the door refuses, naming the missing input (§22.8)",
  "discipline": { "verb": "viewer.counts", "args": { "by": "discipline" }, "col": 0 }
 },
 "links": {
  "_": "§29.1: a LINK word in a building takes the session to that building's record in another app. DATA: `in` the place it works, `kind` the ERP window it opens, `verb` the door line that says WHICH record (the answer's `id` path), `then` the word that makes the record when there is none. Zero code per link.",
  "project": { "in": "building", "kind": "Project", "verb": "erp.order_state", "id": "state.projectId", "then": "post" }
 },
 "welcome": {
  "_": "§26: printed once when `red1` opens on a terminal (never on a pipe, a one-shot line or -f); {version} {verbs} {words} {commit} are read, never typed",
  "lines": [
   "Welcome to red1, the scripting door into BIM and ERP, stored in SQLite.",
   "REMEMBER THE NAME.",
   "Copyright (c) 2026 Redhuan D. OON · red1 {version} · {verbs} verbs · {words} words{commit}",
   "Type help for the list of commands (or bim, mis, erp for one group)."
  ]
 },
 "groups": {
  "_": "§24 (D10, D11): help prints these three groups; a word's FORM belongs to the group of its verb's door app (no hand list of words); `bim`, `mis`, `erp` alone list a group with one typed example per form (`ex`)",
  "bim": { "title": "buildings and models",            "start": "cd Duplex", "apps": ["object", "viewer", "modeller", "model"] },
  "mis": { "title": "records, tables, files, Ninja",   "start": "cd Order",  "apps": ["mis", "ninja"], "session": [["menu", "the ERP menu"]] },
  "erp": { "title": "document actions (CO VO CL RC)",  "start": "cd Order",  "apps": ["erp"] }
 },
 "everywhere": [["cd <place>", "go to a building, a kind of it, an ERP kind or one record of it (cd Order 50000; cd .. back, cd alone: nowhere)"], ["pwd", "where you are"], ["role <id>", "a role on every line"], ["history", "the lines you typed"], ["report", "send the last gap to us (email or GitHub issue)"], ["exit", "leave red1"]],
 "words": {
  "ls":      { "help": "list what is here",                      "forms": [
               { "in": "kind", "ex": "ls element_name=*bath*",     "verb": "object.list",   "args": [], "defaults": { "columns": "$columns", "limit": "20" } },
               { "in": "building", "ex": "ls", "verb": "viewer.counts", "args": [], "defaults": { "by": "discipline" } },
               { "in": "erp", "ex": "ls DocumentNo=5000*",      "verb": "mis.list",      "args": [], "master": "filter", "defaults": { "columns": "$columns", "names": "Y", "limit": "20" } } ] },
  "count":   { "help": "how many",                               "forms": [
               { "in": "kind", "ex": "count",     "verb": "object.count",  "args": [] },
               { "in": "building", "ex": "count storey", "verb": "viewer.counts", "args": ["by"], "defaults": { "by": "discipline" } },
               { "in": "erp", "ex": "count",      "verb": "mis.list",      "args": [], "master": "filter", "defaults": { "columns": "$columns", "limit": "1" } } ] },
  "cat":     { "help": "one record: cat <uu|id>",                "forms": [
               { "in": "kind", "ex": "cat 2O2Fr$t4X7Zf8NOew3FKau",     "verb": "object.read",   "args": ["uu"] },
               { "in": "erp", "ex": "cat 1500004",      "verb": "mis.read",      "args": ["id"], "draw": "record", "ctx": true } ] },
  "sum":     { "help": "add a column: sum <column>",             "forms": [
               { "in": "kind", "ex": "sum <column>",     "verb": "object.sum",    "args": ["column"] },
               { "in": "erp", "ex": "sum GrandTotal",      "verb": "mis.sum",       "args": ["column"], "master": "filter" } ] },
  "group":   { "help": "count by a column: group <column>",      "forms": [
               { "in": "kind", "ex": "group storey",     "verb": "object.group",  "args": ["by"] },
               { "in": "erp", "ex": "group DocStatus",      "verb": "mis.group",     "args": ["by"], "master": "filter" } ] },
  "clash":   { "help": "clashes between two disciplines: clash <A> <B>", "forms": [
               { "in": "building", "ex": "clash ARC MEP", "verb": "viewer.clashes", "args": ["discA", "discB"], "defaults": { "rows": "all" }, "summary": true, "draw": "funnel" } ] },
  "cost":    { "help": "the cost of a selection: cost [phase|task|storey|discipline|class] [column=value …]", "forms": [
               { "in": "building", "ex": "cost discipline", "verb": "viewer.cost", "args": ["by"], "summary": true, "draw": "groups" } ] },
  "post":    { "help": "post the building's priced selection to its ERP Project Order: post [column=value …]  (asks y/N; the selection words are cost's)", "forms": [
               { "in": "building", "ex": "post discipline=ARC", "verb": "erp.process", "args": [], "fixed": { "name": "Fold from BIM" }, "fill": { "Building": "building" }, "fold": "Selection", "confirm": "session" } ] },
  "status":  { "help": "a Project's earned value (PV, EV, AC, SPI, CPI per phase): status [<project>] [asof=YYYY-MM-DD]", "forms": [
               { "in": "erp", "for": "Project", "ex": "status", "verb": "erp.project_status", "args": ["id"], "draw": "status" } ] },
  "vo":      { "help": "issue the change between the model and the Project Order as a Variation Order: vo [column=value …]  (asks y/N; the selection words are cost's; approve it with do CO <number>)", "forms": [
               { "in": "building", "ex": "vo discipline=ARC", "verb": "erp.process", "args": [], "fixed": { "name": "Variation Order" }, "fill": { "Building": "building" }, "fold": "Selection", "confirm": "session" } ] },
  "claim":   { "help": "bill the project's completed phases not yet billed: claim  (a draft invoice and the preview of its accounting; asks y/N; in a Project record)", "forms": [
               { "in": "erp", "for": "Project", "ex": "claim", "verb": "erp.process", "args": ["record"], "fixed": { "name": "Progress Claim" }, "confirm": "session" } ] },
  "grid":    { "help": "the building's grid lines",              "forms": [
               { "in": "building", "ex": "grid", "verb": "modeller.lines", "args": [] } ] },
  "walk":    { "help": "walk a discipline: walk <discipline>",   "forms": [
               { "in": "building", "ex": "walk FP", "verb": "modeller.walk",  "args": ["discipline"] } ] },
  "day":     { "help": "the schedule on a day: day <n>",         "forms": [
               { "in": "building", "ex": "day 5", "verb": "viewer.schedule_at", "args": ["day"] } ] },
  "compare": { "help": "the schedule compared: compare [hours]", "forms": [
               { "in": "building", "ex": "compare 24", "verb": "viewer.schedule_compare", "args": ["shift_hours"] } ] },
  "open":    { "help": "open a model: open <sheets>",            "forms": [
               { "in": "any", "ex": "open marked",      "verb": "model.open",    "args": ["sheets"] } ] },
  "bay":     { "help": "add a bay: bay <end>",                   "forms": [
               { "in": "any", "ex": "bay high",      "verb": "model.addbay",  "args": ["end"] } ] },
  "undo":    { "help": "undo the last model change",             "forms": [
               { "in": "any", "ex": "undo",      "verb": "model.undo",    "args": [] } ] },
  "save":    { "help": "save the model: save [file]",            "forms": [
               { "in": "any", "ex": "save shed.db",      "verb": "model.save",    "args": ["file"] } ] },
  "close":   { "help": "close the model",                        "forms": [
               { "in": "any", "ex": "close",      "verb": "model.close",   "args": [] } ] },
  "new":     { "help": "a new record: new Column=value …",       "forms": [
               { "in": "erp", "ex": "new <Column>=<value>",      "verb": "mis.new",       "args": [], "master": "link" } ] },
  "set":     { "help": "change a record: set <id> Column=value …", "forms": [
               { "in": "erp", "ex": "set 1500004 Description=Rush",      "verb": "mis.update",    "args": ["id"] } ] },
  "rm":      { "help": "delete a record: rm <id> (asks y/N)",    "confirm": true, "forms": [
               { "in": "erp", "ex": "rm 1500004",      "verb": "mis.delete",    "args": ["id"] } ] },
  "do":      { "help": "a document action: do <CO|VO|CL|RC> <number> (or complete, void, close, reverse)", "forms": [
               { "in": "erp", "ex": "do CO 50000", "codes": { "CO": "complete", "VO": "void", "CL": "close", "RC": "reverse" },      "verb": "erp.{1}",       "args": ["number"], "pick": ["complete", "void", "close", "reverse"] } ] },
  "run":     { "help": "run a process of the dictionary: run \"<process>\" [record] [Param=value …]", "forms": [
               { "in": "erp", "ex": "run \"Set Project Type\" 990000 C_ProjectType_ID=103", "verb": "erp.process", "args": ["name", "record"], "ask": "params" } ] },
  "next":    { "help": "what a document may do next: next <number>", "forms": [
               { "in": "erp", "ex": "next 50000",      "verb": "erp.actions",   "args": ["number"], "draw": "tree" } ] },
  "load":    { "help": "load rows from a file: load <file>",     "forms": [
               { "in": "erp", "ex": "load suppliers.csv",      "verb": "mis.load",      "args": ["file"] } ] },
  "diff":    { "help": "compare a file with the records: diff <file>", "forms": [
               { "in": "erp", "ex": "diff suppliers.csv",      "verb": "mis.diff",      "args": ["file"] } ] },
  "ninja":   { "help": "stage a workbook or CSV: ninja <file>",  "forms": [
               { "in": "any", "ex": "ninja Ninja_HRMIS.xlsx",      "verb": "ninja.exec",    "args": ["file"] } ] }
 }
}
