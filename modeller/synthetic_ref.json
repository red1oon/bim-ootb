      "quantity": {
        "basis": "area",
        "formula": "A",
        "unit": "M2"
      },
      "factor": {
        "formula": "t / t_ref",
        "t_ref": "pack_desc_mm",
        "why": "the pack rate is per m2 at the thickness in its description; a thicker wall costs proportionally more per m2"
      },
      "materialByLabel": [
