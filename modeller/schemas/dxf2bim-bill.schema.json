{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "dxf2bim-bill/1",
 "title": "bill.json: quantities x pack rates, by evidence tier",
 "type": "object",
 "required": [
  "format",
  "pack",
  "currency",
  "lines",
  "totals"
 ],
 "properties": {
  "format": {
   "type": "string",
   "const": "dxf2bim-run/1",
   "description": "output contract version; a reader checks it first"
  },
  "pack": {
   "type": "string"
  },
  "currency": {
   "type": "string"
  },
  "lines": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "class",
     "prov",
     "quantity",
     "unit"
    ],
    "properties": {
     "prov": {
      "enum": [
       "drawn",
       "derived",
       "assumed"
      ]
     },
     "quantity": {
      "type": "number"
     }
    }
   }
  },
  "totals": {
   "type": "object",
   "required": [
    "amount",
    "by_prov",
    "by_class"
   ],
   "properties": {
    "amount": {
     "type": "number"
    },
    "by_prov": {
     "type": "object"
    },
    "by_class": {
     "type": "object"
    }
   }
  },
  "flags": {
   "type": "array"
  },
  "log": {
   "type": "string"
  }
 }
}