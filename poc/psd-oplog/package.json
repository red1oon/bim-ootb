    "editor_layers": "node editor/run_layers.js",
    "editor_select": "node editor/run_select.js",
    "editor_photo": "node editor/run_photo.js",
    "editor_history": "node editor/run_history.js",
    "editor_ckpt": "node editor/run_ckpt_editor.js",
    "editor_masks": "node editor/run_masks.js",
    "editor_clip": "node editor/run_clip.js",
    "editor_wand": "node editor/run_wand.js",
    "editor_groups": "node editor/run_groups_editor.js",
    "editor_adjust": "node editor/run_adjust_editor.js",
    "editor_hsl": "node editor/run_hsl.js",
    "editor_admask": "node editor/run_admask.js",
    "editor_fill": "node editor/run_fill.js",
    "editor_feather": "node editor/run_feather.js",
    "editor_gradient": "node editor/run_gradient.js",
    "editor_filters": "node editor/run_filters.js",
    "editor_shapes": "node editor/run_shapes.js",
    "editor_fx": "node editor/run_fx.js",
    "editor_textedit": "node editor/run_textedit.js",
    "editor_imgexport": "node editor/run_imgexport.js",
    "editor_carry": "node editor/run_carry.js",
    "editor_text": "node editor/run_text.js",
    "editor_xform": "node editor/run_xform.js",
    "editor_redpill": "node editor/run_redpill.js",
    "editor_dist_single": "node editor/build_dist.js editor/out/single --single",
