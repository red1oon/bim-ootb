{
  "name": "psd-oplog-poc",
  "private": true,
  "description": "POC: op-log + content-addressed tiles as a PSD-replacement document model (see README)",
  "scripts": {
    "precision": "node exp_precision_blend_speed.js",
    "tiles_psd": "node exp_tiles_psd.js",
