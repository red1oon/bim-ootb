    "psd_independent": "EMIT_DIR=./.emit node psd_roundtrip.js >/dev/null && python3 -I check_psd_independent.py ./.emit",
    "test": "npm run witness && npm run stack && npm run psd && npm run doc && npm run export && npm run groups && npm run nonsep && npm run tiles && npm run adjust && npm run curves && npm run depth16 && npm run icc",
    "icc": "sh icc/fetch_profiles.sh && node icc/run_icc.js",
    "doc": "sh icc/fetch_profiles.sh && node doc/run_doc.js",
    "export": "sh icc/fetch_profiles.sh && node doc/run_export.js",
    "samples": "node doc/run_export.js --no-python",
    "witness_all": "node witness_all.js",
    "groups": "node doc/run_groups.js",
    "panel": "node panel/make_screenshot.js",
    "nonsep": "node doc/run_nonsep.js",
    "tiles": "node tiles/run_tiles.js",
    "adjust": "node doc/run_adjust.js",
    "curves": "node doc/run_curves.js",
    "depth16": "node doc/run_depth16.js",
    "perf": "node perf/run_perf.js",
    "dirty": "node perf/run_dirty.js",
    "ckpt": "node --max-old-space-size=4096 perf/run_ckpt.js",
    "blur": "node filters/run_blur.js",
    "cmfold": "node --max-old-space-size=6000 icc/run_cmfold.js",
    "sha": "node perf/run_sha.js",
    "brush": "node filters/run_brush.js",
    "editor": "node editor/run_editor.js",
    "erase": "node filters/run_erase.js",
